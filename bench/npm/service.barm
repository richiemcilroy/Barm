// An HTTP service validating each JSON body with zod (Barm's server, npm's validator).
import { z } from "zod"

type Body = { name: string, email: string, age: f64 }
const User = try z.object({ name: z.string().min(1), email: z.string().email(), age: z.number().int().nonnegative() })
const port = Number(process.env.PORT ?? 3000)

Bun.serve({
  port,
  async fetch(req) {
    try {
      const body = try await req.json<Body>()
      const r = try User.safeParse(body)
      if (r.success) return Response.json({ ok: true, name: r.data.name as string })
      return new Response("invalid", { status: 400 })
    } catch (e) {
      return new Response("bad json", { status: 400 })
    }
  },
})
