import { readFileSync } from "node:fs"
// Native-only fetch() behaviour: where Barm follows the Fetch standard and Bun doesn't, bodies
// as bytes (u8[]), and failures whose wording is Barm's own.
const base = process.env.BASE ?? "http://127.0.0.1:1"

function describe(e: Error): string {
  if (e instanceof FetchError) {
    return `${e.name} ${e.code}: ${e.message.replaceAll(base, "BASE")}`
  }
  return `${e.name}: ${e.message}`
}

async function show(label: string, p: Promise<Response, Error>): Promise<void> {
  try {
    const r = await p
    const body = await r.text()
    console.log(`${label}: ${r.status} ${r.url.replaceAll(base, "BASE")} | ${body}`)
  } catch (e) {
    console.log(`${label}: ${describe(e)}`)
  }
}

// at most 20 redirects (the Fetch standard)
await show("20 redirects", fetch(base + "/chain?n=20"))
await show("21 redirects", fetch(base + "/chain?n=21"))
// Response.url has no fragment
await show("fragment", fetch(base + "/text#part"))

// bytes
const bytes: u8[] = [104, 105, 0, 255]
await show("POST bytes", fetch(base + "/echo", { method: "POST", body: [u8(111), u8(107)] }))
try {
  const r = await fetch(base + "/big?n=5")
  const b = await r.bytes()
  console.log(`bytes(): ${b}`)
  const made = new Response(bytes)
  const back = await made.bytes()
  console.log(`bytes body: ${back} ${made.headers.get("content-type") ?? "no type"}`)
} catch (e) {
  console.log(`bytes: ${describe(e)}`)
}

// headers iterate sorted, Set-Cookie in its place
try {
  const r = await fetch(base + "/headers")
  const seen: string[] = []
  r.headers.forEach((v, k) => {
    if (k !== "date") {
      seen.push(`${k}=${v}`)
    }
  })
  console.log(`headers: ${seen.join(" ")}`)
  console.log(`keys: ${r.headers.keys().join(",")}`)
} catch (e) {
  console.log(`headers: ${describe(e)}`)
}

// failures
await show("dropped", fetch(base + "/drop"))
await show("malformed", fetch(base + "/malformed"))
await show("cut short", fetch(base + "/short"))
await show("bad gzip", fetch(base + "/badgzip"))
await show("bad brotli", fetch(base + "/badbr"))
await show("bad zstd", fetch(base + "/badzstd"))
// a pooled connection the server closed is replaced (the request is retried once)
await show("warm up", fetch(base + "/text"))
await show("pooled then dropped", fetch(base + "/drop"))
await show("still fine", fetch(base + "/text"))

// signals
const a = new AbortController()
const b = new AbortController()
const either = AbortSignal.any([a.signal, b.signal])
let heard = ""
either.onabort = () => {
  heard += "onabort "
}
either.addEventListener("abort", () => {
  heard += "listener"
})
const pending = fetch(base + "/slow?ms=2000", { signal: either })
b.abort(new Error("b gave up"))
await show("any", pending)
console.log(`heard: ${heard} aborted=${either.aborted} a=${a.signal.aborted}`)
try {
  either.throwIfAborted()
  console.log("throwIfAborted: no")
} catch (e) {
  console.log(`throwIfAborted: ${e.message}`)
}
const d = new DOMException("gone", "AbortError")
console.log(`DOMException: ${d.name} ${d.code} ${d.message} ${d instanceof Error}`)

// Blob parts and File contents as bytes
const raw: u8[] = [0, 255, 1, 13, 10]
const rb = new Blob(["<", raw, ">"])
console.log(`bytes blob: ${rb.size} ${(await rb.bytes()).join(",")} ${(await rb.slice(1, 3).arrayBuffer()).join(",")}`)
const binForm = new FormData()
binForm.append("bin", new File([raw], "raw.bin"))
binForm.append("plain", new Blob(["p"]))
binForm.append("typed", new File(["<p>"], "t.html", { type: "text/html" }))
binForm.append("png", new Blob(["png"], { type: "image/png" }), "i.png")
try {
  const back = try await (try await fetch(base + "/mirror", { method: "POST", body: binForm })).formData()
  const bin = back.get("bin")
  const plain = back.get("plain")
  if (bin instanceof File && plain instanceof File) {
    console.log(`bytes form: ${bin.name} ${JSON.stringify(bin.type)} ${(await bin.bytes()).join(",")} | ${plain.name} ${await plain.text()}`)
  }
  const typed = back.get("typed")
  const png = back.get("png")
  if (typed instanceof File && png instanceof File) {
    console.log(`typed files: ${typed.name} ${typed.type} ${await typed.text()} | ${png.name} ${png.type} ${await png.text()}`)
  }
} catch (e) {
  console.log(`bytes form: ${e.message}`)
}
let streamed = ""
for await (const chunk of rb.stream()) {
  streamed += chunk.join(",")
}
console.log(`blob stream: ${streamed}`)

// compressed bodies stream decoded, in chunks of at most 4 MiB however well they compress
async function decodedStream(label: string, url: string): Promise<void> {
  try {
    const r = await fetch(url)
    const decoder = new TextDecoder()
    let body = ""
    let most = 0
    for await (const chunk of r.body!) {
      most = chunk.length > most ? chunk.length : most
      body += decoder.decode(chunk, { stream: true })
    }
    body += decoder.decode()
    console.log(`${label}: ${body.byteLength} bytes, chunks <= 4 MiB: ${most <= 4194304}, same as fixture: ${body === fixture}`)
  } catch (e) {
    console.log(`${label}: ${e.message}`)
  }
}
const fixture = try readFileSync("tests/fetch/fixture.txt", "utf8")
await decodedStream("streamed brotli", base + "/br?f=fixture.br")
await decodedStream("streamed zstd", base + "/zstd?f=fixture.zst")
await decodedStream("streamed deflate", base + "/deflate?f=fixture.zlib")
await decodedStream("streamed gzip", base + "/gzip?f=fixture.gz")
try {
  const r = await fetch(base + "/gzip?f=fixture-zeros.gz")
  let total = 0
  let most = 0
  for await (const chunk of r.body!) {
    most = chunk.length > most ? chunk.length : most
    total += chunk.length
  }
  console.log(`streamed zeros: ${total} bytes, chunks <= 4 MiB: ${most <= 4194304}`)
} catch (e) {
  console.log(`streamed zeros: ${e.message}`)
}

// a gzip trailer that claims 4 GiB: rejected, without reserving it
await show("lying gzip size", fetch(base + "/gzip?f=fixture-lying.gz"))

// a body that has all arrived but isn't all decoded: read whole later, or dropped
function sleep(ms: number): Promise<void> {
  return new Promise((resolve) => {
    setTimeout(resolve, ms)
  })
}
try {
  const r = await fetch(base + "/gzip?f=fixture-zeros.gz")
  await sleep(100)
  const t = await r.text()
  console.log(`zeros read whole later: ${t.byteLength}`)
  const b = await (await fetch(base + "/gzip?f=fixture-zeros.gz")).bytes()
  console.log(`zeros bytes(): ${b.length}`)
  const dropped = await fetch(base + "/gzip?f=fixture-zeros.gz")
  await sleep(50)
  console.log(`dropped while decoding: ${dropped.status}`)
} catch (e) {
  console.log(`zeros read whole: ${e.message}`)
}

// a pending AbortSignal.timeout doesn't keep the program running
const later = AbortSignal.timeout(60000)
await show("with a long timeout", fetch(base + "/text", { signal: later }))
console.log("done")
