function sign(n: int): string {
  if (n > 0) {
    return "positive"
  } else if (n < 0) {
    return "negative"
  }
}

function label(kind: "a" | "b" | "c"): int {
  let score = 0
  switch (kind) {
    case "a":
      score = 1
    case "b":
      score = 2
      break
    case "c":
      return 3
  }
  return score
  console.log("done")
}

function stray() {
  break
}
