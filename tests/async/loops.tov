// Loops around awaits: a run that waits part-way through a loop picks up where it left off, with
// every kind of local (ints, floats, flags, strings, objects) as it was, through continue, break,
// errors and tasks that take turns.
class Counter {
  n: int
  constructor() {
    this.n = 0
  }
}

class Log {
  items: string[]
  constructor() {
    this.items = []
  }
}

class Odd extends Error {}

function sleep(ms: number): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, ms))
}

// (never waits)
async function add(a: int, b: int): Promise<int> {
  return a + b
}

// (never waits; fails on odd numbers)
async function half(n: int): Promise<int> throws Odd {
  if (n % 2 === 1) {
    throw new Odd("odd " + String(n))
  }
  return n * 5
}

async function tick(i: int): Promise<int> {
  await Promise.resolve(0)
  return i
}

async function locals(): Promise<string> {
  let total = 0
  let f = 0.5
  let flag = false
  let s = ""
  const c = new Counter()
  for (let i = 0; i < 6; i++) {
    if (i === 2) {
      continue
    }
    total = await add(total, i)
    f = f * 2
    flag = !flag
    s = s + String(i)
    c.n += i
    if (i % 2 === 0) {
      await sleep(1)
    }
    total += await tick(i)
  }
  return `${total} ${f} ${flag} ${s} ${c.n}`
}

async function errors(): Promise<string> {
  let out = ""
  let i = 0
  while (true) {
    i++
    if (i > 7) {
      break
    }
    try {
      const h = try await half(i)
      await sleep(1)
      out = out + "h" + String(h)
    } catch (e) {
      out = out + "!" + e.message.slice(4)
      if (i === 5) {
        continue
      }
    } finally {
      out = out + ";"
    }
  }
  return out
}

async function worker(name: string, rounds: int, log: Log): Promise<int> {
  let sum = 0
  let j = 0
  do {
    await tick(j)
    sum = await add(sum, j)
    log.items.push(name + String(j))
    j++
  } while (j < rounds)
  return sum
}

async function nested(): Promise<int> {
  let n = 0
  for (const row of [1, 2, 3]) {
    for (let k = 0; k < row; k++) {
      n = await add(n, row * 10 + k)
      if (k === 1) {
        await sleep(1)
      }
    }
  }
  return n
}

async function main() {
  console.log(await locals())
  console.log(await errors())
  const log = new Log()
  const sums = await Promise.all([worker("a", 3, log), worker("b", 4, log)])
  console.log(sums.join(","), log.items.join(" "))
  console.log(await nested())
  let i = 0
  let spins = 0
  for (; i < 100000; i++) {
    spins = await add(spins, 1)
  }
  console.log(i, spins)
}
