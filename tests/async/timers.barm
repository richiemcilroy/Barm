// Timers: setTimeout/setInterval/clearTimeout and promises resolved by timers. No two events are
// closer than 20 ms, so the order doesn't depend on scheduling jitter (in Node either).
function sleep(ms: number): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, ms))
}

async function main() {
  setTimeout(() => console.log("timeout 120"), 120)
  const cancelled = setTimeout(() => console.log("never"), 60)
  setTimeout(() => console.log("timeout 30"), 30)
  clearTimeout(cancelled)
  let ticks = 0
  let interval = 0
  interval = setInterval(() => {
    ticks++
    console.log("interval", ticks)
    if (ticks === 3) {
      clearInterval(interval)
    }
  }, 90)
  console.log("scheduled")
  await sleep(10)
  console.log("slept 10")
  await sleep(330)
  console.log("slept 340, ticks", ticks)
  const results: string[] = []
  const a = (async () => {
    await sleep(60)
    results.push("a")
  })()
  const b = (async () => {
    await sleep(20)
    results.push("b")
  })()
  await a
  await b
  console.log("results", results.join(","))
  setTimeout(() => console.log("last timer"), 1)
}
