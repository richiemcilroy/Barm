function main() {
  const a = 17
  const b = 5
  console.log(a + b, a - b, a * b, a / b, a % b, -a % b, a ** 2)
  console.log(7 / 2, 1 / 3, 2 ** 0.5, 10 / 4)
  const x = 2.5
  console.log(Math.floor(x), Math.ceil(x), Math.round(x), Math.round(-2.5), Math.trunc(-2.7))
  console.log(Math.abs(-3), Math.abs(-2.5), Math.min(3, 1, 2), Math.max(1.5, 2), Math.sqrt(16), Math.PI)
  console.log(0.1 + 0.2, 1e21, 1e-7, 123456789012, 2 ** 53, -0.0 === 0.0)
  console.log(5 & 3, 5 | 3, 5 ^ 3, 1 << 10, -16 >> 2, 255 >>> 4)
  console.log(parseInt("42"), parseInt("ff", 16), parseFloat("3.25"), Number("12e2"))
  console.log(isNaN(0.0 / 0.0), 1.0 / 0.0, -1.0 / 0.0)
  let total = 0
  for (let i = 1; i <= 100; i++) total += i
  let avg = 0
  avg += total / 100
  console.log(total, avg)
}
