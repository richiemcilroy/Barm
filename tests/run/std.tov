// The standard library: node:fs, node:path, process, Date, performance, JSON (validated parse).
import { readFileSync, writeFileSync, existsSync, mkdirSync, readdirSync, rmSync, appendFileSync } from "node:fs"
import * as path from "node:path"

type Point = { x: int, y: f64, label?: string }
type Shape = { kind: "circle", r: f64 } | { kind: "rect", w: f64, h: f64 }
type Config = { name: string, points: Point[], shapes: Shape[], mode: "fast" | "slow", enabled: bool }

function main() {
  const dir = "/tmp/tov-std-test"
  try rmSync(dir, { recursive: true, force: true })
  try mkdirSync(path.join(dir, "a", "b"), { recursive: true })
  try writeFileSync(path.join(dir, "a", "hello.txt"), "hello\n")
  try appendFileSync(path.join(dir, "a", "hello.txt"), "world\n")
  console.log(try readFileSync(path.join(dir, "a", "hello.txt"), "utf8"))
  console.log(existsSync(dir), existsSync(path.join(dir, "nope")), try readdirSync(path.join(dir, "a")))
  try {
    readFileSync(path.join(dir, "missing.txt"), "utf8")
  } catch (e) {
    console.log(e.message.startsWith("ENOENT: no such file or directory, open"))
  }
  console.log(path.basename("/a/b/c.txt"), path.basename("/a/b/c.txt", ".txt"), path.dirname("/a/b/c.txt"), path.extname("x/y.tar.gz"))
  console.log(path.join("a", "..", "b", "./c/"), path.normalize("/a//b/../c/."), path.isAbsolute("/x"), path.sep)
  console.log(process.argv.length >= 2, typeof process.platform, process.env.HOME !== undefined, process.env.TOV_SURELY_UNSET)
  console.log(Date.now() > 1600000000000, performance.now() >= 0)

  const text = `{"name": "demo", "points": [{"x": 1, "y": 2.5}, {"x": -3, "y": 0, "label": "o\\u00e9"}],
    "shapes": [{"kind": "rect", "w": 2, "h": 3}, {"kind": "circle", "r": 1}], "mode": "slow", "enabled": true, "extra": [1, {"z": null}]}`
  const cfg: Config = try JSON.parse(text)
  console.log(cfg.name, cfg.points.length, cfg.points[1]!.label, cfg.shapes[0]!.kind, cfg.mode, cfg.enabled)
  console.log(JSON.stringify(cfg.points))
  console.log(JSON.stringify({ a: 1, b: [true, false], c: "q\"x", d: undefined, e: 0.1 + 0.2 }))
  console.log(JSON.stringify(cfg.shapes, undefined, 2))
  for (const bad of [`{"name": 1}`, `[1, 2`, `{"name": "x", "points": [], "shapes": [], "mode": "medium", "enabled": false}`]) {
    try {
      const c: Config = JSON.parse(bad)
      console.log("parsed", c.name)
    } catch (e) {
      console.log(e.name)
    }
  }
  const counts: Map<string, int> = try JSON.parse(`{"a": 1, "b": 2}`)
  console.log(counts.get("b"), counts.size, JSON.stringify(counts))
  const n: int[] = try JSON.parse("[1, 2, 3]")
  console.log(n, try JSON.parse("\"hi\"") as string)
}
