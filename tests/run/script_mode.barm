// A script (top-level statements), module state, async/await, Record literals, object
// methods, throwing closures, generic static and instance methods, literal narrowing.
type Todo = { id: int, title: string }

const todos: Todo[] = [{ id: 1, title: "a" }]
let added = 0

function add(title: string): Todo {
  added += 1
  const t: Todo = { id: todos.length + 1, title }
  todos.push(t)
  return t
}

class Box<T> {
  readonly value: T
  constructor(value: T) {
    this.value = value
  }
  static of<U>(value: U): Box<U> {
    return new Box(value)
  }
  map<R>(f: (v: T) => R): Box<R> {
    return new Box(f(this.value))
  }
}

type Handler = (body: string) => string throws Error

function run(h: Handler, body: string): string {
  try {
    return h(body)
  } catch (e) {
    return "caught: " + e.message
  }
}

async function twice(n: int): Promise<int> {
  return n * 2
}

console.log("start", added)
add("b")
const c = add("c")
console.log(c.id, c.title, added, todos.length)
console.log(await twice(21))

const headers = new Headers({ "Content-Type": "text/plain", "X-Id": "7" })
console.log(headers.get("content-type") ?? "-", headers.get("x-id") ?? "-", headers.has("nope"))

const ops = {
  double(n: int): int {
    return n * 2
  },
  async greet(name: string): Promise<string> {
    return "hi " + name
  },
}
console.log(ops.double(4), await ops.greet("ada"))

console.log(run((b) => b.toUpperCase(), "ok"))
console.log(run((b) => {
  if (b === "") {
    throw new Error("empty")
  }
  return b
}, ""))
console.log(run((b) => {
  const t = try JSON.parse(b) as Todo
  return t.title
}, '{"id":1,"title":"parsed"}'))

console.log(Box.of("x").value, Box.of(3).map((n) => n + 1).value, new Box([1, 2]).map((xs) => xs.length).value)

function describe(path: string): string {
  if (path === "/") {
    return "root " + path
  }
  return "other " + path
}
console.log(describe("/"), describe("/a"))

const n = Number(process.env.BARM_UNSET_VAR ?? 8080)
console.log(n ?? 0, Number("12.5") ?? 0)
for (const t of todos) {
  console.log(t.id, t.title)
}
