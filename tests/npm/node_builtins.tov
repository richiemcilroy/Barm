import run from "node-builtins"
import { EventEmitter } from "node:events"
import { format, inspect } from "node:util"

async function main() {
  // Node.js's built-ins used by an npm package
  try await (try run())
  // and imported straight into Tov
  const e = try new EventEmitter()
  try e.on("ping", (x: Js) => console.log("ping", x as int))
  try e.emit("ping", 7)
  console.log(try format("%s=%d", "n", 42) as string)
  console.log(try inspect({ a: [1, 2], b: "x" }) as string)
}
