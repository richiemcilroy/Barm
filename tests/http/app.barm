// The server driven by tests/http.rs (Bun's API; `main` style, with workers).

type Item = { id: int, name: string }

// `/echo` answers asynchronously (it awaits the body); everything else synchronously, so the
// protocol tests (pipelining especially) mix both kinds of response.
async function echo(req: Request): Promise<Response> {
  const body = await req.text()
  return new Response(body, { status: 200, headers: { "content-type": "application/octet-stream" } })
}

function route(req: Request): Response | Promise<Response> throws TypeError {
  const url = try new URL(req.url)
  const path = url.pathname
  if (path === "/") {
    return new Response("hello")
  }
  if (path === "/echo") {
    return echo(req)
  }
  if (path === "/info") {
    const h = req.headers
    return new Response(req.method + " " + path + " " + url.search + " " + (h.get("X-NAME") ?? "-") + " " + (h.get("user-agent") ?? "-") + " " + req.url)
  }
  if (path === "/json") {
    const items: Item[] = [{ id: 1, name: "a" }, { id: 2, name: "b" }]
    return Response.json(items, { status: 201 })
  }
  if (path === "/inject") {
    const h = new Headers()
    h.set("x-value", url.search.slice(1).replaceAll("%0D", "\r").replaceAll("%0A", "\n"))
    h.set("X-Other", "1")
    h.set("x-other", "2")
    h.append("x-multi", "a")
    h.append("x-multi", "b")
    return new Response("ok", { headers: h })
  }
  if (path === "/empty") {
    return new Response(undefined, { status: 204 })
  }
  if (path === "/big") {
    return new Response("x".repeat(4 * 1024 * 1024))
  }
  if (path === "/crash") {
    const xs: int[] = []
    return new Response("unreachable " + String(xs[url.search.byteLength]!))
  }
  if (path === "/log") {
    console.log("logged " + url.search)
    return new Response("ok")
  }
  return new Response("not found", { status: 404 })
}

function main(): void {
  const port = parseInt(process.env.PORT ?? "0") ?? 0
  const workers = parseInt(process.env.WORKERS ?? "1") ?? 1
  Bun.serve({ port, workers, hostname: "127.0.0.1", fetch: route })
}
