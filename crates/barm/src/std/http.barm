// std/http — Bun's web server API for native programs. The names are also globals, as in
// Bun: `Bun.serve`, `Request`, `Response`, `Headers`, `URL`, `URLSearchParams`.
//
//   const server = Bun.serve({
//     port: 3000,
//     routes: { "/users/:id": (req) => Response.json({ id: req.params.id }) },
//     fetch(req) { return new Response("Not Found", { status: 404 }) },
//   })
//
// The event loop, HTTP/1.1 parser and writer are native (kqueue/epoll, keep-alive, pipelining).
// Servers start serving when the program's top level (or `main`) finishes. `workers: n` (a
// Barm extension) forks n processes that share the sockets, supervised by the parent: a worker
// that dies is replaced, and SIGTERM/SIGINT stop them all.

function check(): void throws Error {
  const err = __native.takeError()
  if (err !== "") {
    throw new Error(err)
  }
}

export type HeadersInit = Headers | Record<string, string>

// Header names are case-insensitive; the block is "name: value\r\n" lines, as sent.
export class Headers {
  private raw: string

  constructor(init?: HeadersInit) {
    this.raw = ""
    if (init instanceof Headers) {
      this.raw = init.raw
    } else if (init !== undefined) {
      for (const k of init.keys()) {
        this.raw = __native.headerAppend(this.raw, k, init.get(k) ?? "")
      }
    }
  }

  static fromWire(raw: string): Headers {
    const h = new Headers()
    h.raw = raw
    return h
  }

  // Every value of `name`, joined with ", " (as the Fetch standard combines them).
  get(name: string): string | undefined {
    if (__native.headerIndex(this.raw, name) < 0) {
      return undefined
    }
    return __native.headerGet(this.raw, name)
  }

  // Each Set-Cookie header on its own (`get` would join them).
  getSetCookie(): string[] {
    return __native.headerValues(this.raw, "set-cookie")
  }

  has(name: string): bool {
    return __native.headerIndex(this.raw, name) >= 0
  }

  append(name: string, value: string): void {
    this.raw = __native.headerAppend(this.raw, name, value)
  }

  set(name: string, value: string): void {
    this.raw = __native.headerAppend(__native.headerRemove(this.raw, name), name, value)
  }

  delete(name: string): void {
    this.raw = __native.headerRemove(this.raw, name)
  }

  // `f(value, name)` for each header, as the Fetch API iterates them: names in lower case and
  // sorted, repeated names combined (Set-Cookie excepted).
  forEach(f: (value: string, name: string) => void): void {
    const e = __native.headerEntries(this.raw)
    for (let i = 0; i + 1 < e.length; i += 2) {
      f(e[i + 1]!, e[i]!)
    }
  }

  keys(): string[] {
    const e = __native.headerEntries(this.raw)
    const out: string[] = []
    for (let i = 0; i < e.length; i += 2) {
      out.push(e[i]!)
    }
    return out
  }

  values(): string[] {
    const e = __native.headerEntries(this.raw)
    const out: string[] = []
    for (let i = 1; i < e.length; i += 2) {
      out.push(e[i]!)
    }
    return out
  }

  toJSON(): Record<string, string> {
    const out: Record<string, string> = {}
    const e = __native.headerEntries(this.raw)
    for (let i = 0; i + 1 < e.length; i += 2) {
      const prev = out.get(e[i]!)
      out.set(e[i]!, prev === undefined ? e[i + 1]! : prev + ", " + e[i + 1]!)
    }
    return out
  }

  wire(): string {
    return this.raw
  }
}

// `?a=1&b=x+y`, percent-decoded (`+` is a space).
export class URLSearchParams {
  private names: string[]
  private values: string[]

  constructor(init?: string) {
    this.names = []
    this.values = []
    let q = init ?? ""
    if (q.startsWith("?")) {
      q = q.slice(1)
    }
    if (q === "") {
      return
    }
    for (const part of q.split("&")) {
      if (part === "") {
        continue
      }
      const eq = part.indexOf("=")
      if (eq < 0) {
        this.names.push(__native.urlDecode(part, true))
        this.values.push("")
      } else {
        this.names.push(__native.urlDecode(part.slice(0, eq), true))
        this.values.push(__native.urlDecode(part.slice(eq + 1), true))
      }
    }
  }

  get(name: string): string | undefined {
    for (let i = 0; i < this.names.length; i++) {
      if (this.names[i]! === name) {
        return this.values[i]!
      }
    }
    return undefined
  }

  getAll(name: string): string[] {
    const out: string[] = []
    for (let i = 0; i < this.names.length; i++) {
      if (this.names[i]! === name) {
        out.push(this.values[i]!)
      }
    }
    return out
  }

  has(name: string): bool {
    return this.names.includes(name)
  }

  // Replaces the first `name` in place and drops the rest (or appends).
  set(name: string, value: string): void {
    const names: string[] = []
    const values: string[] = []
    let found = false
    for (let i = 0; i < this.names.length; i++) {
      if (this.names[i]! !== name) {
        names.push(this.names[i]!)
        values.push(this.values[i]!)
      } else if (!found) {
        found = true
        names.push(name)
        values.push(value)
      }
    }
    if (!found) {
      names.push(name)
      values.push(value)
    }
    this.names = names
    this.values = values
  }

  append(name: string, value: string): void {
    this.names.push(name)
    this.values.push(value)
  }

  delete(name: string): void {
    const names: string[] = []
    const values: string[] = []
    for (let i = 0; i < this.names.length; i++) {
      if (this.names[i]! !== name) {
        names.push(this.names[i]!)
        values.push(this.values[i]!)
      }
    }
    this.names = names
    this.values = values
  }

  get size(): int {
    return this.names.length
  }

  toString(): string {
    const parts: string[] = []
    for (let i = 0; i < this.names.length; i++) {
      parts.push(__native.urlEncode(this.names[i]!) + "=" + __native.urlEncode(this.values[i]!))
    }
    return parts.join("&")
  }
}

// A WHATWG URL: `new URL("http://host:8080/a?b#c")`, or relative with a base. Kept as its
// normalized href; the parts are sliced from it when read.
export class URL {
  private h: string
  // parsed on first use
  private params: URLSearchParams | undefined

  constructor(input: string, base?: string) throws TypeError {
    const href = __native.urlNormalize(input, base ?? "")
    if (href === "") {
      throw new TypeError(`"${input}" cannot be parsed as a URL.`)
    }
    this.h = href
    this.params = undefined
  }

  get protocol(): string {
    return __native.urlPart(this.h, 0)
  }

  get hostname(): string {
    return __native.urlPart(this.h, 1)
  }

  get port(): string {
    return __native.urlPart(this.h, 2)
  }

  get pathname(): string {
    return __native.urlPart(this.h, 3)
  }

  get search(): string {
    return __native.urlPart(this.h, 4)
  }

  get hash(): string {
    return __native.urlPart(this.h, 5)
  }

  get searchParams(): URLSearchParams {
    const p = this.params
    if (p !== undefined) {
      return p
    }
    const made = new URLSearchParams(this.search)
    this.params = made
    return made
  }

  get host(): string {
    return this.port === "" ? this.hostname : this.hostname + ":" + this.port
  }

  // "null" for schemes without an origin (`mailto:`, `file:`, ...), as in the URL standard.
  get origin(): string {
    const p = this.protocol
    if (p !== "http:" && p !== "https:" && p !== "ws:" && p !== "wss:" && p !== "ftp:") {
      return "null"
    }
    return p + "//" + this.host
  }

  get href(): string {
    return this.h
  }

  toString(): string {
    return this.href
  }

  toJSON(): string {
    return this.href
  }

  // The URL, or undefined if `input` isn't one.
  static parse(input: string, base?: string): URL | undefined {
    try {
      return new URL(input, base)
    } catch (e) {
      return undefined
    }
  }

  static canParse(input: string, base?: string): bool {
    return __native.urlParse(input, base ?? "").length > 0
  }
}

// A body: text (sent as is), form fields (`application/x-www-form-urlencoded`), or bytes.
export type BodyInit = string | URLSearchParams | u8[]
export type RequestRedirect = "follow" | "manual" | "error"
export type RequestInit = {
  method?: string
  headers?: HeadersInit
  body?: BodyInit
  // fetch(): what to do with a 3xx response (default "follow", up to 20 times)
  redirect?: RequestRedirect
  // fetch(): cancels the request (it rejects with the signal's reason)
  signal?: AbortSignal
  // fetch() (Bun): decode gzip and deflate bodies (default true)
  decompress?: bool
  // fetch() (Bun): TLS options for https: URLs
  tls?: TLSOptions
  // fetch() (Bun): send the request over this Unix socket (the URL still gives Host and path)
  unix?: string
  // accepted for compatibility; connections are always pooled
  keepalive?: bool
}

// `rejectUnauthorized: false` skips certificate checks (as NODE_TLS_REJECT_UNAUTHORIZED=0 does);
// `ca` adds trusted certificates (PEM) to the system's.
export type TLSOptions = { rejectUnauthorized?: bool, ca?: string }

function bodyText(b: BodyInit): string {
  if (typeof b === "string") {
    return b
  }
  if (b instanceof URLSearchParams) {
    return b.toString()
  }
  return __native.bytesToString(b)
}

// The Content-Type a body implies when the headers don't give one.
function bodyType(b: BodyInit): string {
  return b instanceof URLSearchParams ? "application/x-www-form-urlencoded;charset=UTF-8" : ""
}

// Methods are sent upper-cased, as Bun does ("patch" → "PATCH"; the Fetch standard would keep
// it, and servers answer 405).
function normalizeMethod(m: string): string {
  return m.toUpperCase()
}

export class Request {
  private verb: string
  // a full URL, or for a request from the wire, its target ("/path?query")
  private target: string
  private fromWire: bool
  private rawHeaders: string
  private rawBody: string

  constructor(input: string, init?: RequestInit) {
    const m = init?.method
    this.verb = m === undefined ? "GET" : normalizeMethod(m)
    this.target = input
    this.fromWire = false
    const h = init?.headers
    this.rawHeaders = h === undefined ? "" : new Headers(h).wire()
    const b = init?.body
    this.rawBody = b === undefined ? "" : bodyText(b)
    if (b !== undefined && bodyType(b) !== "" && __native.headerIndex(this.rawHeaders, "content-type") < 0) {
      this.rawHeaders = __native.headerAppend(this.rawHeaders, "Content-Type", bodyType(b))
    }
  }

  get method(): string {
    return this.verb
  }

  // The full URL ("http://host/path?query").
  get url(): string {
    if (!this.fromWire) {
      return this.target
    }
    return __native.requestUrl(this.rawHeaders, this.target)
  }

  get headers(): Headers {
    return Headers.fromWire(this.rawHeaders)
  }

  // As in Bun, the body is read through a promise (already settled: the body has arrived).
  text(): Promise<string> {
    return Promise.resolve(this.rawBody)
  }

  // The body parsed as JSON, checked against the type the context expects.
  json<T>(): Promise<T, SyntaxError> {
    try {
      const value: T = JSON.parse(this.rawBody)
      return Promise.resolve(value)
    } catch (e) {
      return Promise.reject(e)
    }
  }

  // Internal: the header block and body, as sent.
  wireHeaders(): string {
    return this.rawHeaders
  }

  wireBody(): string {
    return this.rawBody
  }

  // Internal: fills in a request read from the wire.
  wire(method: string, target: string, headers: string, body: string): void {
    this.verb = method
    this.target = target
    this.fromWire = true
    this.rawHeaders = headers
    this.rawBody = body
  }
}

// The request a `routes` handler gets: `req.params` holds the route's `:name` segments
// (typed from the route, e.g. `{ id: string }` for "/users/:id").
export class BunRequest extends Request {
  readonly params: Record<string, string>

  constructor(input: string, params: Record<string, string>) {
    super(input)
    this.params = params
  }
}

export type ResponseInit = { status?: number, statusText?: string, headers?: HeadersInit }

export class Response {
  readonly status: int
  readonly statusText: string
  private rawHeaders: string
  private bodyText: string
  // without a body there's no default Content-Type
  private hasBody: bool
  private used: bool
  private finalUrl: string
  private wasRedirected: bool
  // the body is valid UTF-8 without a BOM: text() returns it as it is
  private clean: bool
  // a fetch() response: its request (0 otherwise), whose body arrives after the head; the
  // handle frees the request when the response goes away
  private id: int
  private handle: Promise<int> | undefined
  private signal: AbortSignal | undefined
  private stream: ReadableStream | undefined

  constructor(body?: BodyInit, init?: ResponseInit) {
    this.bodyText = body === undefined ? "" : bodyText(body)
    this.hasBody = body !== undefined
    const status = init?.status
    this.status = status === undefined ? 200 : Math.trunc(status)
    this.statusText = init?.statusText ?? ""
    const h = init?.headers
    this.rawHeaders = h === undefined ? "" : new Headers(h).wire()
    if (body !== undefined && bodyType(body) !== "" && __native.headerIndex(this.rawHeaders, "content-type") < 0) {
      this.rawHeaders = __native.headerAppend(this.rawHeaders, "Content-Type", bodyType(body))
    }
    this.used = false
    this.finalUrl = ""
    this.wasRedirected = false
    this.clean = (body === undefined || typeof body === "string" || body instanceof URLSearchParams) && !this.bodyText.startsWith("\uFEFF")
    this.id = 0
    this.handle = undefined
    this.signal = undefined
    this.stream = undefined
  }

  // Internal: the response to fetch() request `id`, whose head has arrived.
  static fetched(id: int, signal: AbortSignal | undefined): Response {
    const r = new Response(undefined, { status: __native.fetchStatus(id), statusText: __native.fetchStatusText(id) })
    r.rawHeaders = __native.fetchHeaders(id)
    r.finalUrl = __native.fetchUrl(id)
    r.wasRedirected = __native.fetchRedirected(id)
    r.hasBody = true
    r.id = id
    r.handle = __native.fetchHandle(id)
    r.signal = signal
    return r
  }

  get headers(): Headers {
    return Headers.fromWire(this.rawHeaders)
  }

  get ok(): bool {
    return this.status >= 200 && this.status < 300
  }

  // The URL that answered, after redirects ("" for a response made in the program).
  get url(): string {
    return this.finalUrl
  }

  get redirected(): bool {
    return this.wasRedirected
  }

  get type(): string {
    return "default"
  }

  // The body has been read, or its stream started (it can be read once).
  get bodyUsed(): bool {
    const st = this.stream
    return this.used || (st !== undefined && st.disturbed)
  }

  // The body as a stream of byte chunks (undefined for a response made without a body).
  get body(): ReadableStream | undefined {
    const st = this.stream
    if (st !== undefined) {
      return st
    }
    if (this.id === 0 && !this.hasBody) {
      return undefined
    }
    const made = this.id !== 0 ? ReadableStream.fetched(this.id, this.handle, this.signal) : ReadableStream.of(__native.stringToBytes(this.bodyText))
    this.stream = made
    return made
  }

  // Internal: marks the body read (or rejects), and for a fetch() response waits for all of it.
  async whole(): Promise<string> throws Error {
    if (this.bodyUsed) {
      throw new FetchError("Body already used", "ERR_BODY_ALREADY_USED")
    }
    this.used = true
    const id = this.id
    if (id === 0) {
      return this.bodyText
    }
    const r = await __native.fetchBodyWait(id)
    const signal = this.signal
    if (signal !== undefined) {
      signal.unwatch(id)
    }
    if (r !== 0) {
      if (r === -2 && signal !== undefined) {
        try signal.throwIfAborted()
      }
      throw new FetchError(__native.fetchErrorMessage(id), __native.fetchErrorCode(id))
    }
    this.clean = __native.fetchBodyClean(id)
    return __native.fetchBody(id)
  }

  // The body as text (invalid UTF-8 becomes U+FFFD, a leading BOM is dropped).
  async text(): Promise<string> throws Error {
    const body = try await this.whole()
    return this.clean ? body : __native.utf8Clean(body)
  }

  // The body parsed as JSON, checked against the type the context expects.
  async json<T>(): Promise<T> throws Error {
    const text = try await this.text()
    const value: T = try JSON.parse(text)
    return value
  }

  // The body's bytes (Bun's `bytes()`; a `u8[]` stands in for Uint8Array).
  async bytes(): Promise<u8[]> throws Error {
    return __native.stringToBytes(try await this.whole())
  }

  async arrayBuffer(): Promise<u8[]> throws Error {
    return try await this.bytes()
  }

  // A copy that can be read separately.
  clone(): Response throws TypeError {
    if (this.bodyUsed) {
      throw new FetchError("Body already used", "ERR_BODY_ALREADY_USED")
    }
    const r = new Response(this.bodyText, { status: this.status, statusText: this.statusText })
    r.rawHeaders = this.rawHeaders
    r.hasBody = this.hasBody
    r.finalUrl = this.finalUrl
    r.wasRedirected = this.wasRedirected
    r.clean = this.clean
    if (this.id !== 0) {
      // both read the whole body (the request keeps it until the second has it)
      __native.fetchShare(this.id)
      r.id = this.id
      r.handle = this.handle
      r.signal = this.signal
    }
    return r
  }

  // `data` as JSON, with `Content-Type: application/json;charset=utf-8`.
  static json<T>(data: T, init?: ResponseInit): Response {
    const r = new Response(JSON.stringify(data), init)
    if (r.rawHeaders === "") {
      r.rawHeaders = "Content-Type: application/json;charset=utf-8\r\n"
    } else if (__native.headerIndex(r.rawHeaders, "content-type") < 0) {
      r.rawHeaders = __native.headerAppend(r.rawHeaders, "Content-Type", "application/json;charset=utf-8")
    }
    return r
  }

  // A redirect (302 unless given) to `url`.
  static redirect(url: string, status?: number): Response {
    const r = new Response(undefined, { status: status ?? 302 })
    r.rawHeaders = __native.headerAppend("", "Location", url)
    return r
  }

  wireBody(): string {
    return this.bodyText
  }

  wireHeaders(): string {
    return this.rawHeaders
  }

  wireTyped(): bool {
    return this.hasBody
  }
}

export class Server {
  readonly hostname: string
  private id: int
  private boundPort: int

  constructor(hostname: string) {
    this.id = -1
    this.boundPort = 0
    this.hostname = hostname
  }

  get port(): int {
    return this.boundPort
  }

  // Internal: the server is listening.
  bound(id: int, port: int): void {
    this.id = id
    this.boundPort = port
  }

  get url(): URL {
    return URL.parse(`http://${this.hostname}:${this.port}/`)!
  }

  get development(): bool {
    return false
  }

  // Stops accepting connections; open ones finish the request in hand (or close now with
  // `closeActiveConnections`). The program exits when every server has stopped.
  stop(closeActiveConnections?: bool): void {
    __native.httpStop(this.id, closeActiveConnections ?? false)
  }
}

/* What a handler answers with: a response, or (an async handler) a promise of one. */
export type Answer = Response | Promise<Response, Error>
export type Handler = (req: Request, server: Server) => Answer throws Error
export type RouteHandler = (req: BunRequest, server: Server) => Answer throws Error
export type MethodRoutes = {
  GET?: RouteHandler
  POST?: RouteHandler
  PUT?: RouteHandler
  PATCH?: RouteHandler
  DELETE?: RouteHandler
  HEAD?: RouteHandler
  OPTIONS?: RouteHandler
}
export type RouteValue = Response | RouteHandler | MethodRoutes

export type ServeOptions = {
  port?: number | string
  hostname?: string
  routes?: Record<string, RouteValue>
  fetch?: Handler
  error?: (error: Error) => Response
  development?: bool
  // Barm: serve from this many processes.
  workers?: int
}

// A route with `:name` segments or a trailing `*`.
type Pattern = { segments: string[], wildcard: bool, value: RouteValue }

function methodHandler(m: MethodRoutes, method: string): RouteHandler | undefined {
  switch (method) {
    case "GET":
      return m.GET
    case "POST":
      return m.POST
    case "PUT":
      return m.PUT
    case "PATCH":
      return m.PATCH
    case "DELETE":
      return m.DELETE
    case "HEAD":
      return m.HEAD ?? m.GET
    case "OPTIONS":
      return m.OPTIONS
  }
  return undefined
}

function specificity(p: Pattern): int {
  let statics = 0
  for (const s of p.segments) {
    if (!s.startsWith(":")) {
      statics++
    }
  }
  return (p.wildcard ? 0 : 1000) + statics
}

// The params of `path` for a pattern route, or undefined if it doesn't match.
function matchPattern(p: Pattern, path: string): Record<string, string> | undefined {
  const parts = path.split("/")
  const segs = p.segments
  if (p.wildcard) {
    // "/files/*": the prefix, then at least one more segment
    if (parts.length <= segs.length) {
      return undefined
    }
  } else if (parts.length !== segs.length) {
    return undefined
  }
  const params: Record<string, string> = {}
  for (let i = 0; i < segs.length; i++) {
    const seg = segs[i]!
    const part = parts[i]!
    if (seg.startsWith(":")) {
      if (part === "") {
        return undefined
      }
      params.set(seg.slice(1), __native.urlDecode(part, false))
    } else if (seg !== part) {
      return undefined
    }
  }
  if (p.wildcard && parts[segs.length]! === "") {
    return undefined
  }
  return params
}

// An async handler's response: sent once its promise settles (a rejection is answered like an
// error the handler threw). Responses on a connection still go out in request order.
async function respondLater(id: int, pending: Promise<Response, Error>, method: string, target: string, onError: ((error: Error) => Response) | undefined) {
  let res: Response | undefined = undefined
  try {
    res = await pending
  } catch (e) {
    res = internalError(e, method, target, onError)
  }
  const r = res!
  __native.httpRespondTo(id, r.status, r.wireHeaders(), r.wireBody(), r.wireTyped())
}

function internalError(e: Error, method: string, target: string, onError: ((error: Error) => Response) | undefined): Response {
  console.error(`error: ${e.message}\n${method} - ${target} failed`)
  if (onError !== undefined) {
    return onError(e)
  }
  return new Response("Something went wrong!", { status: 500, headers: { "content-type": "text/plain" } })
}

// Starts a server (it serves once the program's top level has run). Exits the program with
// an error if the port can't be bound, as an uncaught error would in Bun.
export function serve(options: ServeOptions): Server {
  const portOpt = options.port ?? 3000
  const port = typeof portOpt === "string" ? parseInt(portOpt) ?? 0 : Math.trunc(portOpt)
  const hostname = options.hostname ?? "0.0.0.0"
  const exact = new Map<string, RouteValue>()
  const patterns: Pattern[] = []
  const routes = options.routes
  if (routes !== undefined) {
    for (const path of routes.keys()) {
      const value = routes.get(path)!
      if (path.includes(":") || path.endsWith("/*")) {
        const wildcard = path.endsWith("/*")
        const segs = (wildcard ? path.slice(0, path.byteLength - 2) : path).split("/")
        patterns.push({ segments: segs, wildcard, value })
      } else {
        exact.set(path, value)
      }
    }
    // More specific first, as in Bun: `:param` routes before wildcards, then more static
    // segments; otherwise in declaration order (the sort is stable).
    patterns.sort((a, b) => specificity(b) - specificity(a))
  }
  const fetch = options.fetch
  const onError = options.error
  const server = new Server(hostname === "0.0.0.0" ? "localhost" : hostname)
  const noParams: Record<string, string> = {}

  const run = (value: RouteValue, params: Record<string, string>, method: string, target: string, headers: string, body: string): Answer | undefined => {
    if (value instanceof Response) {
      return value
    }
    const h = typeof value === "function" ? value : methodHandler(value, method)
    if (h === undefined) {
      return undefined
    }
    const req = new BunRequest(target, params)
    req.wire(method, target, headers, body)
    try {
      return h(req, server)
    } catch (e) {
      return internalError(e, method, target, onError)
    }
  }

  const handle = (method: string, target: string, headers: string, body: string): Answer => {
    const q = target.indexOf("?")
    const path = q < 0 ? target : target.slice(0, q)
    const v = exact.get(path)
    if (v !== undefined) {
      const r = run(v, noParams, method, target, headers, body)
      if (r !== undefined) {
        return r
      }
    }
    for (const p of patterns) {
      const params = matchPattern(p, path)
      if (params !== undefined) {
        const r = run(p.value, params, method, target, headers, body)
        if (r !== undefined) {
          return r
        }
      }
    }
    if (fetch !== undefined) {
      const req = new Request(target)
      req.wire(method, target, headers, body)
      try {
        return fetch(req, server)
      } catch (e) {
        return internalError(e, method, target, onError)
      }
    }
    return new Response("Not Found", { status: 404 })
  }

  const id = __native.httpListen(port, hostname, (method: string, target: string, headers: string, body: string): void => {
    const res = handle(method, target, headers, body)
    if (res instanceof Response) {
      __native.httpRespond(res.status, res.wireHeaders(), res.wireBody(), res.wireTyped())
    } else {
      // Nothing observable follows (the loop runs microtasks next), so the response can go out
      // at once if the handler's promise is already settled.
      __native.spawnTail()
      respondLater(__native.httpDefer(), res, method, target, onError)
    }
  })
  if (id < 0) {
    console.error(`error: ${__native.takeError()}`)
    process.exit(1)
  }
  __native.httpWorkers(options.workers ?? 1)
  server.bound(id, __native.httpPort(id))
  return server
}

// A web platform error: `name` says which ("AbortError", "TimeoutError", ...).
export class DOMException extends Error {
  readonly code: int

  constructor(message?: string, name?: string) {
    super(message ?? "")
    const n = name ?? "Error"
    this.name = n
    this.code = n === "AbortError" ? 20 : n === "TimeoutError" ? 23 : 0
  }
}

// Says when to stop: `fetch` rejects with `reason` once the signal is aborted.
export class AbortSignal {
  private flag: bool
  private why: Error | undefined
  private listeners: (() => void)[]
  // fetch() requests to cancel
  private watching: int[]
  onabort: (() => void) | undefined

  constructor() {
    this.flag = false
    this.why = undefined
    this.listeners = []
    this.watching = []
    this.onabort = undefined
  }

  get aborted(): bool {
    return this.flag
  }

  get reason(): Error | undefined {
    return this.why
  }

  throwIfAborted(): void throws Error {
    const why = this.why
    if (why !== undefined) {
      throw why
    }
  }

  // `listener` runs once, when the signal aborts ("abort" is the only event).
  addEventListener(event: string, listener: () => void): void {
    if (event === "abort") {
      this.listeners.push(listener)
    }
  }

  // A signal that is already aborted.
  static abort(reason?: Error): AbortSignal {
    const s = new AbortSignal()
    s.fire(reason ?? new DOMException("The operation was aborted.", "AbortError"))
    return s
  }

  // A signal that aborts with a TimeoutError after `ms` milliseconds (the timer doesn't keep
  // the program running by itself).
  static timeout(ms: number): AbortSignal {
    const s = new AbortSignal()
    const id = setTimeout(() => {
      s.fire(new DOMException("The operation timed out.", "TimeoutError"))
    }, ms)
    __native.timerUnref(id)
    return s
  }

  // A signal that aborts when any of `signals` does, with its reason.
  static any(signals: AbortSignal[]): AbortSignal {
    const s = new AbortSignal()
    for (const each of signals) {
      const why = each.why
      if (why !== undefined) {
        s.fire(why)
        return s
      }
    }
    for (const each of signals) {
      each.addEventListener("abort", () => {
        const why = each.why
        if (why !== undefined) {
          s.fire(why)
        }
      })
    }
    return s
  }

  // Internal: aborts with `reason` (once).
  fire(reason: Error): void {
    if (this.flag) {
      return
    }
    this.flag = true
    this.why = reason
    for (const id of this.watching) {
      __native.fetchAbort(id)
    }
    this.watching = []
    const on = this.onabort
    if (on !== undefined) {
      on()
    }
    const ls = this.listeners
    this.listeners = []
    for (const l of ls) {
      l()
    }
  }

  // Internal: fetch() request `id` is cancelled when this aborts, until it has finished.
  watch(id: int): void {
    this.watching.push(id)
  }

  unwatch(id: int): void {
    if (this.watching.includes(id)) {
      this.watching = this.watching.filter((w) => w !== id)
    }
  }
}

export class AbortController {
  readonly signal: AbortSignal

  constructor() {
    this.signal = new AbortSignal()
  }

  // Aborts the signal with `reason` (a DOMException "AbortError" if not given).
  abort(reason?: Error): void {
    this.signal.fire(reason ?? new DOMException("The operation was aborted.", "AbortError"))
  }
}

// Text to UTF-8 bytes (`u8[]` stands in for Uint8Array).
export class TextEncoder {
  readonly encoding: string

  constructor() {
    this.encoding = "utf-8"
  }

  encode(input?: string): u8[] {
    return __native.stringToBytes(input ?? "")
  }
}

export type TextDecoderOptions = { fatal?: bool, ignoreBOM?: bool }
export type TextDecodeOptions = { stream?: bool }

// UTF-8 bytes to text: invalid bytes become U+FFFD and a leading BOM is dropped (unless
// `ignoreBOM`). With `{ stream: true }` a character cut off at the end of one chunk is
// completed by the next, so a body's chunks decode as the whole would.
export class TextDecoder {
  readonly encoding: string
  readonly fatal: bool
  readonly ignoreBOM: bool
  private pending: u8[]
  private started: bool

  constructor(label?: string, options?: TextDecoderOptions) throws RangeError {
    const l = (label ?? "utf-8").trim().toLowerCase()
    if (l !== "utf-8" && l !== "utf8" && l !== "unicode-1-1-utf-8") {
      throw new RangeError(`The "${label ?? ""}" encoding is not supported`)
    }
    this.encoding = "utf-8"
    this.fatal = options?.fatal ?? false
    this.ignoreBOM = options?.ignoreBOM ?? false
    this.pending = []
    this.started = false
  }

  decode(input?: u8[], options?: TextDecodeOptions): string throws TypeError {
    const stream = options?.stream ?? false
    let bytes = input ?? []
    if (this.pending.length > 0) {
      bytes = this.pending.concat(bytes)
      this.pending = []
    }
    const whole = stream ? __native.utf8Complete(bytes) : bytes.length
    if (whole < bytes.length) {
      this.pending = bytes.slice(whole)
      bytes = bytes.slice(0, whole)
    }
    let raw = __native.bytesToString(bytes)
    // the BOM is dropped once, at the start of a stream
    if (!this.started && !this.ignoreBOM && raw.startsWith("\uFEFF")) {
      raw = raw.slice(3)
    }
    this.started = stream
    const text = __native.utf8Clean(raw)
    if (this.fatal && text !== raw) {
      throw new TypeError("The encoded data was not valid for encoding utf-8")
    }
    return text
  }
}

// One read from a stream: a chunk, or `done` at the end.
export type ReadableStreamReadResult = { done: bool, value: u8[] | undefined }

// A body as a stream of byte chunks: `res.body`. Read it with `getReader()` (`read()` until
// `done`) or `for await (const chunk of res.body)`. A fetch() body streams as it arrives.
export class ReadableStream {
  // a fetch() request's body (0: the chunks below)
  private id: int
  private handle: Promise<int> | undefined
  private signal: AbortSignal | undefined
  private chunks: u8[][]
  private isLocked: bool
  private started: bool
  private finished: bool

  constructor() {
    this.id = 0
    this.handle = undefined
    this.signal = undefined
    this.chunks = []
    this.isLocked = false
    this.started = false
    this.finished = false
  }

  // Internal: the body of fetch() request `id`.
  static fetched(id: int, handle: Promise<int> | undefined, signal: AbortSignal | undefined): ReadableStream {
    const s = new ReadableStream()
    s.id = id
    s.handle = handle
    s.signal = signal
    return s
  }

  // Internal: a stream of one chunk.
  static of(bytes: u8[]): ReadableStream {
    const s = new ReadableStream()
    if (bytes.length > 0) {
      s.chunks.push(bytes)
    }
    return s
  }

  // A reader is reading it.
  get locked(): bool {
    return this.isLocked
  }

  // Reading has started.
  get disturbed(): bool {
    return this.started
  }

  getReader(): ReadableStreamDefaultReader throws TypeError {
    if (this.isLocked) {
      throw new TypeError("ReadableStream is locked")
    }
    this.isLocked = true
    return new ReadableStreamDefaultReader(this)
  }

  // Stops the body: a fetch() request is aborted (its connection closed).
  async cancel(): Promise<void> {
    this.started = true
    this.finished = true
    this.chunks = []
    if (this.id !== 0) {
      __native.fetchAbort(this.id)
    }
  }

  // Internal: the reader's read().
  async pull(): Promise<ReadableStreamReadResult> throws Error {
    this.started = true
    const id = this.id
    if (id === 0 || this.finished) {
      const c = this.chunks.shift()
      if (c === undefined) {
        return { done: true, value: undefined }
      }
      return { done: false, value: c }
    }
    const n = await __native.fetchRead(id)
    if (n > 0) {
      return { done: false, value: __native.fetchTake(id) }
    }
    this.finished = true
    const signal = this.signal
    if (signal !== undefined) {
      signal.unwatch(id)
    }
    if (n < 0) {
      if (n === -2 && signal !== undefined) {
        try signal.throwIfAborted()
      }
      throw new FetchError(__native.fetchErrorMessage(id), __native.fetchErrorCode(id))
    }
    return { done: true, value: undefined }
  }

  // Internal: the reader let go.
  unlock(): void {
    this.isLocked = false
  }
}

export class ReadableStreamDefaultReader {
  private stream: ReadableStream
  private released: bool

  constructor(stream: ReadableStream) {
    this.stream = stream
    this.released = false
  }

  // The next chunk, or `done` at the end. Rejects if the body fails (or its request is aborted).
  async read(): Promise<ReadableStreamReadResult> throws Error {
    if (this.released) {
      throw new TypeError("This reader has released its lock")
    }
    return try await this.stream.pull()
  }

  releaseLock(): void {
    if (!this.released) {
      this.released = true
      this.stream.unlock()
    }
  }

  async cancel(): Promise<void> {
    await this.stream.cancel()
  }
}

// A failed fetch(): a TypeError with Bun's message and `code` ("ConnectionRefused",
// "ENOTFOUND", "TooManyRedirects", "UnexpectedRedirect", "ECONNRESET", ...).
export class FetchError extends TypeError {
  readonly code: string

  constructor(message: string, code: string) {
    super(message)
    this.name = "TypeError"
    this.code = code
  }
}

// Bun's fetch(): an HTTP/1.1 request on a pooled keep-alive connection, resolving once the
// response's head has arrived; the body follows (`res.text()`, `res.json()`, `res.body`...).
// Rejects with a FetchError when the request fails (an HTTP error status still resolves), or
// with the signal's reason when it is aborted.
export async function fetch(input: string | URL | Request, init?: RequestInit): Promise<Response> throws Error {
  let method = "GET"
  let url = ""
  let headers = ""
  let body = ""
  if (typeof input === "string") {
    url = input
  } else if (input instanceof URL) {
    url = input.href
  } else {
    url = input.url
    method = input.method
    headers = input.wireHeaders()
    body = input.wireBody()
  }
  let redirect = 0
  let flags = 1
  let ca = ""
  let unix = ""
  let signal: AbortSignal | undefined = undefined
  if (init !== undefined) {
    const m = init.method
    if (m !== undefined) {
      method = normalizeMethod(m)
    }
    const h = init.headers
    if (h !== undefined) {
      headers = new Headers(h).wire()
    }
    const b = init.body
    if (b !== undefined) {
      body = bodyText(b)
      const t = bodyType(b)
      if (t !== "" && __native.headerIndex(headers, "content-type") < 0) {
        headers = __native.headerAppend(headers, "Content-Type", t)
      }
    }
    const r = init.redirect
    redirect = r === "manual" ? 1 : r === "error" ? 2 : 0
    if (init.decompress === false) {
      flags = 0
    }
    const tls = init.tls
    if (tls !== undefined) {
      if (tls.rejectUnauthorized === false) {
        flags += 2
      }
      ca = tls.ca ?? ""
    }
    unix = init.unix ?? ""
    signal = init.signal
  }
  if ((method === "GET" || method === "HEAD") && body !== "") {
    throw new FetchError("fetch() request with GET/HEAD method cannot have body.", "ERR_INVALID_ARG_VALUE")
  }
  if (signal !== undefined) {
    try signal.throwIfAborted()
  }
  const id = __native.fetchStart(method, url, headers, body, redirect, flags, ca, unix)
  if (signal !== undefined) {
    signal.watch(id)
  }
  // the head: the body follows (the signal can still abort it)
  const result = await __native.fetchWait(id)
  if (result !== 0) {
    if (signal !== undefined) {
      signal.unwatch(id)
    }
    const message = __native.fetchErrorMessage(id)
    const code = __native.fetchErrorCode(id)
    __native.fetchFree(id)
    if (result === -2 && signal !== undefined) {
      try signal.throwIfAborted()
    }
    throw new FetchError(message, code)
  }
  return Response.fetched(id, signal)
}

// The `Bun` global (only `Bun.serve` so far).
export const Bun = { serve: serve }
