// The barm landing page, served by Barm. Files are read from public/ on each request, so an
// edit shows on the next reload; `barm dev` restarts the server when this file changes.
//
//   cd site && barm dev        (PORT defaults to 4747)

import { readFileSync } from "node:fs"

function contentType(name: string): string {
  if (name.endsWith(".html")) {
    return "text/html;charset=utf-8"
  }
  if (name.endsWith(".svg")) {
    return "image/svg+xml"
  }
  if (name.endsWith(".css")) {
    return "text/css;charset=utf-8"
  }
  if (name.endsWith(".png")) {
    return "image/png"
  }
  return "application/octet-stream"
}

const server = Bun.serve({
  port: process.env.PORT ?? 4747,
  fetch(req) {
    const path = (try new URL(req.url)).pathname
    const name = path === "/" ? "index.html" : path.slice(1)
    if (name.includes("..")) {
      return new Response("Not Found", { status: 404 })
    }
    try {
      const body = readFileSync(`public/${name}`)
      const page = name.endsWith(".html")
      return new Response(body, {
        headers: {
          "content-type": contentType(name),
          "cache-control": page ? "public, max-age=300" : "public, max-age=86400",
        },
      })
    } catch (e) {
      return new Response("Not Found", { status: 404 })
    }
  },
})
console.log(`Listening on ${server.url}`)
