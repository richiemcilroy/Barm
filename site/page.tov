// ---------------------------------------------------------------- the page

// The page, with `footer` (HTML) saying how it was made: served by site/server.tov, or written
// out by site/build.tov.
export function renderPage(footer: string): string {
  return `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tov, the programming language for coding agents</title>
<meta name="description" content="Faster than Rust, written like TypeScript. Tov is the programming language for coding agents: the syntax they know, the exact fix for every error, and native binaries that beat Rust on speed, compile time and memory.">
<meta name="theme-color" content="#F5F6F9">
<meta property="og:type" content="website">
<meta property="og:url" content="https://tov.sh/">
<meta property="og:site_name" content="Tov">
<meta property="og:title" content="Tov: faster than Rust, written like TypeScript">
<meta property="og:description" content="The programming language for coding agents. Native binaries that beat Rust on speed, compile time and memory.">
<meta property="og:image" content="https://tov.sh/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Tov, a hummingbird: faster than Rust, written like TypeScript.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Tov: faster than Rust, written like TypeScript">
<meta name="twitter:description" content="The programming language for coding agents. Native binaries that beat Rust on speed, compile time and memory.">
<meta name="twitter:image" content="https://tov.sh/og.png">
<link rel="icon" href="/logo.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin>
<style>${css}</style>
<script>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
<script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
<pre id="prompt" hidden>${esc(agentPrompt)}</pre>
<pre id="install" hidden>${installLine}</pre>
<div class="wrap">
  <header class="top">
    <a class="brand" href="/" aria-label="Tov, home">${bird}tov</a>
    <nav aria-label="Main">
      <ul>
        <li class="optional"><a href="#speed">Benchmarks</a></li>
        <li class="optional"><a href="#cap">Cap</a></li>
        <li class="optional"><a href="/llms.txt">llms.txt</a></li>
        <li><a href="${repo}/blob/main/docs/spec.md">Spec</a></li>
        <li><a href="${repo}">GitHub</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <div class="hero">
      <p class="badge"><span class="dot" aria-hidden="true"></span>Experimental: under active development</p>
      <h1><span>Faster than Rust.</span> <span>Written like TypeScript.</span></h1>
      <p class="lede">The programming language for coding agents. They already know the syntax, every error comes with its fix, and the binaries <strong>beat Rust's</strong> on speed, compile time and memory.</p>
      <div class="actions">
        ${copyButton("prompt", "Copy the prompt for your agent", "Copied: paste it to your agent", "primary")}
        <div class="install"><code><span class="d">$</span> ${installLine}</code>${copyButton("install", "Copy", "Copied", "small")}</div>
      </div>

      ${renderRaces()}
    </div>

    <section id="agents">
      <h2>Your agent writes it. Tov fixes it. You ship it.</h2>
      <div class="loop" role="group" aria-label="How an agent works with Tov">
        <div class="step"><h3><span>1</span>Your agent writes TypeScript</h3><pre>${written}</pre></div>
        <div class="step"><h3><span>2</span>Tov says exactly what to fix</h3><pre>${checked}</pre></div>
        <div class="step"><h3><span>3</span>You ship a native binary</h3><pre>${shipped}</pre></div>
      </div>
      <div class="reasons">
        <div>
          <h3>Nothing new to learn</h3>
          <p>TypeScript's syntax with Bun's and Node's APIs: <code>Bun.serve</code>, <code>fetch</code>, <code>node:fs</code>, <code>async</code>/<code>await</code> and npm packages.</p>
        </div>
        <div>
          <h3>Nothing hidden</h3>
          <p>No <code>any</code>, <code>null</code> or <code>==</code>. Calls that can fail are marked <code>try</code>. Code that looks like TypeScript behaves like it, or doesn't compile.</p>
        </div>
        <div>
          <h3>Feedback in milliseconds</h3>
          <p>Programs compile in about 40 ms. <code>--watch</code> restarts on save, and <code>tov test</code> runs the tests next to the code.</p>
        </div>
      </div>
    </section>

    <section id="speed">
      <div class="bench">
        <h2>Faster than Rust, in less of everything</h2>
        <p class="intro">Tov compiles to C, and counts references instead of collecting garbage: no pauses, and small binaries.</p>
        ${renderBench()}
        <p class="fine">Apple M4 Max; every program prints the same output. Tov beat Rust on every measurement but one, a tie. Tov checks integer overflow by default; Rust's release builds don't. <a href="${repo}/tree/main/bench">Method and every result</a>.</p>
      </div>
    </section>

    <section id="cap">
      <div class="cap-head">
        <p class="pair" aria-hidden="true">${capLogo}<span>×</span><img src="/logo.svg" alt="" width="55" height="44"></p>
        <h2>Tov at Cap</h2>
        <p class="intro">Cap, the open-source screen recorder, put Tov on its hardest code.</p>
      </div>
      <div class="cap-grid">
        <article class="cap-card enc">
          <h3>A video encoder, written in Tov</h3>
          <p class="cap-big"><b>5.2×</b><span>faster than x264, at the same quality</span></p>
          ${renderClips()}
          <dl class="cap-stats">
            <div><dt>46 MB</dt><dd>peak memory (x264: 377)</dd></div>
            <div><dt>561 KB</dt><dd>its binary (x264: 1.3 MB)</dd></div>
          </dl>
          <p class="cap-fine">capcodec, Cap's H.264 encoder, against x264's veryfast preset on 12 screen recordings at 1080p, one thread. <a href="https://github.com/CapSoftware/Cap/blob/capcodec-encoder-aa45/apps/media-server/capcodec-benchmarks.md">Every result</a>.</p>
        </article>
        <article class="cap-card ms">
          <h3>Cap's media server, unchanged</h3>
          <p>A Bun app with Hono, zod and FFmpeg's native addon, running on Tov without a line changed. Its npm packages run on JavaScriptCore, built into the binary.</p>
          <pre class="code">${npmExample}</pre>
          <ul class="facts">
            <li><b>105 ms</b><span>to start (Bun: 132)</span></li>
            <li><b>23% less</b><span>CPU for each video it probes</span></li>
            <li><b>65 MB</b><span>after a burst of load (Bun: 68–70)</span></li>
          </ul>
          <p class="cap-fine">Against Bun 1.4 on an Apple M4 Max. <a href="${repo}/tree/main/bench/cap-media">Method and every result</a>.</p>
        </article>
      </div>
    </section>

    <section id="start">
      <div class="start">
        <div>
          <h2>Start with your agent</h2>
          <p>Paste this to your coding agent. It installs Tov, reads <a href="/llms.txt">llms.txt</a>, and fixes its own mistakes with <code>tov check --json</code>.</p>
        </div>
        <div class="prompt-card">
          <pre>${esc(agentPrompt)}</pre>
          ${copyButton("prompt", "Copy prompt", "Copied", "primary")}
        </div>
      </div>
    </section>

    <section id="status">
      <h2>What works today</h2>
      <div class="status">
        <div class="yes">
          <h3>Works</h3>
          <ul>
            <li>Command-line programs and web servers</li>
            <li>Records, unions, generics, classes, interfaces and checked errors</li>
            <li><code>async</code>/<code>await</code>, timers, <code>fetch()</code> over HTTP and HTTPS</li>
            <li>Bun's server API and a Node-style standard library</li>
            <li>npm packages, including native addons</li>
            <li>macOS and Linux</li>
          </ul>
        </div>
        <div class="not">
          <h3>Not yet</h3>
          <ul>
            <li>Windows</li>
            <li>A package manager of its own (install with npm or Bun)</li>
            <li>TLS sockets and worker threads for npm packages</li>
            <li>Tuples, enums and a few other TypeScript features (see the spec)</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</div>

<footer>
  <div class="wrap">
    <img src="/logo.svg" alt="" width="44" height="35">
    <p>${footer}</p>
  </div>
</footer>
<script>${script}</script>
</body>
</html>
`
}

// ---------------------------------------------------------------- llms.txt

// The language for agents (llmstxt.org): how to work with Tov, then the spec in full.
export function renderLlms(spec: string): string {
  return `# Tov

> Tov is a programming language for coding agents: TypeScript's syntax, compiled to native binaries faster than Rust's. If code looks like TypeScript it behaves like TypeScript, or it is a compile error with a code and a fix.

## Working with Tov

- Install: \`${installLine}\` (builds from source; needs git and a C compiler, installs Rust if missing).
- Source files end in \`.tov\`. A program is a script, or has \`function main()\`.
- After every edit run \`tov check --json <files>\`. Each diagnostic has a code, a message and fixes; apply the fixes marked "safe" as they are. \`tov explain <CODE>\` describes a code.
- \`tov run main.tov\` builds and runs; \`tov build main.tov -o app\` writes one native binary; \`tov test\` runs every \`test(...)\`; \`--watch\` rebuilds on save.
- npm packages: install them with npm or Bun, then import them. Values from JavaScript have the type \`Js\`; convert them with \`as\` (checked), and mark calls into JavaScript \`try\`.
- Repository: ${repo}

## The language: what differs from TypeScript

${spec}`
}
