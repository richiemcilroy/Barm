// The landing page: its content as data and the functions that render it to HTML.

import { css } from "./style"

export const repo = "https://github.com/richiemcilroy/Tov"

// (how long a render took isn't known until it's done: a footer can hold `renderMsMark`, and the
// caller writes the time there)
export const renderMsMark = "<!--render-ms-->"

// ---------------------------------------------------------------- benchmarks

type Bar = { who: string, value: f64, label: string }
type Group = { name: string, bars: Bar[] }
type Chart = { title: string, how: string, groups: Group[] }

function ms(who: string, value: f64): Bar {
  return { who: who, value: value, label: `${Math.round(value)} ms` }
}

function rate(who: string, value: f64, label: string): Bar {
  return { who: who, value: value, label: label }
}

// bench/README.md, bench/http/README.md, bench/fetch/README.md (Apple M4 Max)
const programs: Chart = {
  title: "Programs",
  how: "Median wall time. Every language prints the same output. Shorter is faster.",
  groups: [
    { name: "binary_trees", bars: [ms("Tov", 266), ms("Rust", 801), ms("C", 703), ms("Bun", 390)] },
    { name: "nbody", bars: [ms("Tov", 211), ms("Rust", 229), ms("C", 319), ms("Bun", 510)] },
    { name: "map_insert", bars: [ms("Tov", 253), ms("Rust", 508), ms("C", 471), ms("Bun", 742)] },
    { name: "sort", bars: [ms("Tov", 47), ms("Rust", 75), ms("C", 282), ms("Bun", 697)] },
  ],
}

const servers: Chart = {
  title: "Web servers and clients",
  how: "Requests per second. Longer is faster.",
  groups: [
    {
      name: "HTTP server, JSON, 1 core (Linux)",
      bars: [rate("Tov", 371, "371k"), rate("Rust", 294, "294k"), rate("Bun", 257, "257k")],
    },
    {
      name: "HTTP server, JSON, 4 cores (Linux)",
      bars: [rate("Tov", 1610, "1.61M"), rate("Rust", 1300, "1.30M"), rate("Bun", 958, "958k")],
    },
    {
      name: "fetch(), 64 requests at once",
      bars: [rate("Tov", 179, "179k"), rate("Rust", 145, "145k"), rate("Bun", 128, "128k"), rate("Node", 31.3, "31k")],
    },
  ],
}

function renderGroup(g: Group): string {
  let max = 0.0
  for (const b of g.bars) {
    max = Math.max(max, b.value)
  }
  const rows = g.bars.map(b => {
    const width = (b.value / max * 100).toFixed(1)
    const us = b.who === "Tov" ? " us" : ""
    return `<li class="bar${us}"><span class="who">${b.who}</span><span class="track"><span class="fill" style="width:${width}%"></span></span><span class="val">${b.label}</span></li>`
  })
  return `<div class="group"><h4>${g.name}</h4><ul class="bars">${rows.join("")}</ul></div>`
}

function renderChart(c: Chart): string {
  return `<div class="chart"><h3>${c.title}</h3><p class="how">${c.how}</p>${c.groups.map(renderGroup).join("")}</div>`
}

// ---------------------------------------------------------------- the agent loop

// a hello-world server, as an agent first writes it, the compiler's answer, and the build
// (real output: tov check --json, trimmed, and tov build)
const written = [
  `<span class="d">// hello.tov</span>`,
  `Bun.serve({`,
  `  port: 3000,`,
  `  fetch(req) {`,
  `    <span class="k">const</span> url = <mark>new URL(req.url)</mark>`,
  `    <span class="k">return new</span> Response(<span class="s">\`Hello from \${url.pathname}\`</span>)`,
  `  },`,
  `})`,
].join("\n")

const checked = [
  `<span class="d">$</span> tov check --json`,
  `{`,
  `  <span class="a">"code"</span>: <span class="e">"T0831"</span>,`,
  `  <span class="a">"message"</span>: "\`new URL\` can throw \`TypeError\`; mark the call \`try\` to pass the error on, or catch it",`,
  `  <span class="a">"fixes"</span>: [{`,
  `    <span class="a">"applicability"</span>: <span class="f">"safe"</span>,`,
  `    <span class="a">"edits"</span>: [{ "line": 4, "col": 17, "text": <span class="f">"try "</span> }]`,
  `  }]`,
  `}`,
].join("\n")

const shipped = [
  `<span class="d">// the agent applies the fix</span>`,
  `<span class="k">const</span> url = <ins>try</ins> new URL(req.url)`,
  ``,
  `<span class="d">$</span> tov build hello.tov`,
  `build: hello`,
  `<span class="d">$</span> ls -lh hello`,
  `<span class="a">152K</span> hello`,
  `<span class="d">$</span> ./hello & curl :3000/agents`,
  `Hello from /agents`,
].join("\n")

// ---------------------------------------------------------------- the page

const npmExample = [
  `<span class="d">// main.tov: Cap's media server, as Bun runs it</span>`,
  `<span class="k">import</span> server <span class="k">from</span> <span class="s">"cap-media-server"</span>`,
  `<span class="k">import</span> { serve } <span class="k">from</span> <span class="s">"bun"</span>`,
  ``,
  `<span class="k">function</span> main() {`,
  `  <span class="k">try</span> serve(server)`,
  `}`,
].join("\n")

const startCode = [
  `<span class="d">$</span> git clone ${repo}`,
  `<span class="d">$</span> cd Tov && cargo install --path crates/tov`,
  ``,
  `<span class="d">$</span> tov run examples/shapes     <span class="d"># build and run</span>`,
  `<span class="d">$</span> tov --watch server.tov     <span class="d"># rebuild on save</span>`,
  `<span class="d">$</span> tov check --json src/      <span class="d"># errors and fixes, for tools</span>`,
  `<span class="d">$</span> tov build app.tov -o app   <span class="d"># one native binary</span>`,
].join("\n")

// The page, with `footer` (HTML) saying how it was made: served by site/server.tov, or written
// out by site/build.tov.
export function renderPage(footer: string): string {
  return `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tov, a programming language for coding agents</title>
<meta name="description" content="Tov looks like TypeScript, so your coding agent already knows how to write it. The compiler hands back exact fixes, and you get a small native binary that keeps pace with Rust.">
<link rel="icon" href="/logo.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin>
<style>${css}</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <a class="brand" href="/"><img src="/logo.svg" alt="" width="44" height="31">tov</a>
    <nav aria-label="Main">
      <ul>
        <li class="optional"><a href="#speed">Benchmarks</a></li>
        <li><a href="${repo}/blob/main/docs/spec.md">Spec</a></li>
        <li><a href="${repo}">GitHub</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <div class="hero">
      <h1>A programming language for coding agents.</h1>
      <p class="lede">Tov looks like TypeScript, so <strong>your agent already knows how to write it</strong>. The compiler checks every line and hands back the exact fix for each error. What comes out is a small native binary that <strong>keeps pace with Rust</strong>.</p>
      <div class="actions">
        <a class="btn primary" href="#start">Get started</a>
        <a class="btn" href="${repo}">View on GitHub</a>
      </div>
      <p class="note">Tov is early. It runs on macOS and Linux.</p>

      <div class="loop" role="group" aria-label="How an agent works with Tov">
        <div class="step"><h3><span>1</span>Your agent writes TypeScript</h3><pre>${written}</pre></div>
        <div class="step"><h3><span>2</span>Tov says exactly what to fix</h3><pre>${checked}</pre></div>
        <div class="step"><h3><span>3</span>You ship a native binary</h3><pre>${shipped}</pre></div>
      </div>
      <p class="loop-caption">A web server in a 152 KB binary: no runtime to install, no <code>node_modules</code>, no garbage collector.</p>
    </div>

    <section id="why">
      <h2>Made for the way agents work</h2>
      <p class="intro">Agents are good at TypeScript and bad at guessing. Tov keeps the language they know and removes the guesswork.</p>
      <div class="reasons">
        <div>
          <h3>Nothing new to learn</h3>
          <p>Tov is TypeScript's syntax with Bun's and Node's APIs: <code>Bun.serve</code>, <code>fetch</code>, <code>node:fs</code>, <code>async</code>/<code>await</code>. If code looks like TypeScript, it behaves like TypeScript, or it doesn't compile.</p>
        </div>
        <div>
          <h3>Nothing hidden</h3>
          <p>No <code>any</code>, <code>null</code> or <code>==</code>. Every call that can fail is marked <code>try</code>, integer overflow stops the program, and arrays and records are values, so nothing changes behind the agent's back.</p>
        </div>
        <div>
          <h3>Errors that come with the fix</h3>
          <p>Every error has a code, a reason and a fix. <code>tov check --json</code> returns the exact edit and marks the ones that are safe to apply as they are. <code>tov explain</code> describes any code.</p>
        </div>
        <div>
          <h3>Feedback in a tenth of a second</h3>
          <p>Builds take about 0.1 s and are cached. <code>--watch</code> rebuilds and restarts on save, and <code>tov test</code> runs the tests written next to the code.</p>
        </div>
      </div>
    </section>

    <section id="speed">
      <h2>It keeps pace with Rust</h2>
      <p class="intro">Tov compiles to C and hands it to your system's compiler. Memory is reference-counted, so there are no garbage collection pauses, and a program is one small file.</p>
      <div class="charts">
        ${renderChart(programs)}
        ${renderChart(servers)}
      </div>
      <p class="fine">Apple M4 Max; the Linux numbers run in Docker on the same machine. The Rust server is axum (thread-per-core on 4 cores) and the client is reqwest. Tov checks integer overflow by default; Rust's release builds don't. <a href="${repo}/tree/main/bench">Method, every result and caveats</a>.</p>
    </section>

    <section id="npm">
      <div class="npm">
        <div>
          <h2>Bring your npm packages</h2>
          <p class="intro">Tov programs import npm packages, and apps written for Bun run on Tov unchanged. Your Tov code compiles to native code. The packages run on JavaScriptCore, built into the binary.</p>
          <pre class="code">${npmExample}</pre>
        </div>
        <div>
          <p class="intro">Cap's media server uses Hono, zod, FFmpeg through a native addon, <code>Bun.serve</code> and <code>Bun.spawn</code>. On Tov, without a line changed:</p>
          <ul class="facts">
            <li><b>105 ms</b><span>to start, against 120 ms on Bun</span></li>
            <li><b>27% less</b><span>CPU for each video it probes than on Bun</span></li>
            <li><b>129 MB</b><span>peak memory under load, against 143 MB on Bun</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section id="status">
      <h2>What works today</h2>
      <div class="status">
        <div class="yes">
          <h3>Works</h3>
          <ul>
            <li>Command-line programs and web servers</li>
            <li>Records, unions, generics, classes, interfaces and checked errors</li>
            <li><code>async</code>/<code>await</code>, timers, <code>fetch()</code> over HTTP and HTTPS</li>
            <li>Bun's server API and a Node-style standard library</li>
            <li>npm packages, including native addons</li>
            <li>macOS and Linux</li>
          </ul>
        </div>
        <div class="not">
          <h3>Not yet</h3>
          <ul>
            <li>Windows</li>
            <li>A package manager of its own (install with npm or Bun)</li>
            <li>TLS sockets and worker threads for npm packages</li>
            <li>Tuples, enums and a few other TypeScript features (see the spec)</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="start">
      <div class="start">
        <div>
          <h2>Get started</h2>
          <p>You need Rust, to build the compiler, and a C compiler (<code>clang</code> or <code>gcc</code>).</p>
          <p>To get your agent going, point it at <a href="${repo}/blob/main/docs/spec.md">the spec</a>. It lists only what differs from TypeScript, so it's short.</p>
        </div>
        <pre class="code">${startCode}</pre>
      </div>
    </section>
  </main>
</div>

<footer>
  <div class="wrap">
    <img src="/logo.svg" alt="" width="40" height="29">
    <p>${footer}</p>
  </div>
</footer>
</body>
</html>
`
}
