// The landing page (tov.sh): its content as data and the functions that render it to HTML, and
// llms.txt, the language for agents.

import { css } from "./style"

export const repo = "https://github.com/richiemcilroy/Tov"

// (how long a render took isn't known until it's done: a footer can hold `renderMsMark`, and the
// caller writes the time there)
export const renderMsMark = "<!--render-ms-->"

// ---------------------------------------------------------------- the race

// One result per runtime. The balls cross their lanes in time with them: Tov's sets the pace
// (`pace` seconds a crossing), and each other takes as many times longer as it's slower.
type Lane = { who: string, value: f64, label: string }
type Race = { id: string, tab: string, title: string, higher: bool, worse: string, lanes: Lane[] }

const pace = 0.9

function lane(who: string, value: f64, label: string): Lane {
  return { who: who, value: value, label: label }
}

// bench/scoreboard.py, 2026-10-06 (Apple M4 Max, macOS; load average ~6)
const races: Race[] = [
  {
    id: "http",
    tab: "Web server",
    title: "Requests a second, a JSON API on one core",
    higher: true,
    worse: "slower",
    lanes: [lane("Tov", 241689, "242k/s"), lane("Rust (axum)", 216499, "216k/s"), lane("Bun", 110644, "111k/s")],
  },
  {
    id: "fetch",
    tab: "HTTP client",
    title: "fetch(), 64 requests at once",
    higher: true,
    worse: "slower",
    lanes: [lane("Tov", 176827, "177k/s"), lane("Rust (reqwest)", 162416, "162k/s"), lane("Bun", 128760, "129k/s"), lane("Node", 30282, "30k/s")],
  },
  {
    id: "trees",
    tab: "Program",
    title: "binary_trees: millions of small objects made and freed",
    higher: false,
    worse: "slower",
    lanes: [lane("Tov", 260, "260 ms"), lane("Bun", 376, "376 ms"), lane("Node", 449, "449 ms"), lane("C", 688, "688 ms"), lane("Rust", 791, "791 ms")],
  },
  {
    id: "compile",
    tab: "Compile",
    title: "Compiling a program to a native binary",
    higher: false,
    worse: "slower",
    lanes: [lane("Tov", 42, "42 ms"), lane("C (clang)", 49, "49 ms"), lane("Rust (rustc)", 98, "98 ms")],
  },
  {
    id: "memory",
    tab: "Memory",
    title: "Memory, serving that JSON API",
    higher: false,
    worse: "more",
    lanes: [lane("Tov", 1.6, "1.6 MB"), lane("Rust (axum)", 4.4, "4.4 MB"), lane("Bun", 16.6, "17 MB")],
  },
]

function renderLane(r: Race, l: Lane, tov: f64): string {
  const ratio = r.higher ? tov / l.value : l.value / tov
  const us = l.who === "Tov"
  const seconds = Math.min(pace * ratio, 9.0)
  const vs = us ? (r.worse === "more" ? "least" : "fastest") : `${ratio.toFixed(1)}× ${r.worse}`
  return `<li class="lane${us ? " us" : ""}" style="--t:${seconds.toFixed(2)}s"><span class="who">${l.who}</span><span class="track"><span class="ball"></span></span><span class="val"><b>${l.label}</b><i>${vs}</i></span></li>`
}

function renderRaces(): string {
  const inputs = races.map((r, i) => `<input type="radio" name="race" id="race-${r.id}" class="race-pick"${i === 0 ? " checked" : ""}>`).join("")
  const tabs = races.map(r => `<label for="race-${r.id}">${r.tab}</label>`).join("")
  const boards = races.map(r => {
    const tov = r.lanes[0]!.value
    return `<div class="board board-${r.id}"><p class="race-title">${r.title}</p><ul class="lanes">${r.lanes.map(l => renderLane(r, l, tov)).join("")}</ul></div>`
  }).join("")
  return `<div class="race" aria-label="Tov against Rust, Bun and Node">${inputs}<div class="tabs" role="presentation">${tabs}</div><div class="boards">${boards}</div></div>`
}

// ---------------------------------------------------------------- the benchmarks

// Each benchmark a row of results, Tov's first.
type Entry = { who: string, value: f64, label: string }
type Row = { name: string, what: string, higher: bool, word: string, entries: Entry[] }

function e(who: string, value: f64, label: string): Entry {
  return { who: who, value: value, label: label }
}

function t(who: string, value: f64): Entry {
  return { who: who, value: value, label: `${Math.round(value)} ms` }
}

// bench/results/scoreboard-20261006-205209.json
const programRows: Row[] = [
  { name: "binary_trees", what: "millions of small objects", higher: false, word: "faster", entries: [t("Tov", 260), t("Bun", 376), t("Node", 449), t("C", 688), t("Rust", 791)] },
  { name: "sort", what: "3M floats, with a comparator", higher: false, word: "faster", entries: [t("Tov", 45), t("Rust", 74), t("C", 275), t("Bun", 696), t("Node", 1175)] },
  { name: "map_insert", what: "2M string keys", higher: false, word: "faster", entries: [t("Tov", 284), t("C", 476), t("Rust", 490), t("Bun", 823), t("Node", 1178)] },
  { name: "dispatch", what: "50M virtual calls", higher: false, word: "faster", entries: [t("Tov", 36), t("C", 76), t("Rust", 77), t("Bun", 109), t("Node", 191)] },
  { name: "strings", what: "format, join, split", higher: false, word: "faster", entries: [t("Tov", 143), t("Bun", 203), t("Rust", 224), t("C", 253), t("Node", 519)] },
  { name: "fib", what: "recursive calls, overflow-checked", higher: false, word: "faster", entries: [t("Tov", 416), t("Rust", 444), t("C", 490), t("Bun", 942), t("Node", 1485)] },
  { name: "nbody", what: "floating point", higher: false, word: "faster", entries: [t("Tov", 210), t("Rust", 224), t("C", 312), t("Bun", 512), t("Node", 554)] },
]

const systemRows: Row[] = [
  { name: "web server", what: "JSON API, one core", higher: true, word: "faster", entries: [e("Tov", 241689, "242k req/s"), e("Rust", 216499, "216k req/s"), e("Bun", 110644, "111k req/s")] },
  { name: "server memory", what: "serving that API", higher: false, word: "less", entries: [e("Tov", 1.6, "1.6 MB"), e("Rust", 4.4, "4.4 MB"), e("Bun", 16.6, "16.6 MB")] },
  { name: "fetch()", what: "64 requests at once", higher: true, word: "faster", entries: [e("Tov", 176827, "177k req/s"), e("Rust", 162416, "162k req/s"), e("Bun", 128760, "129k req/s"), e("Node", 30282, "30k req/s")] },
  { name: "compile", what: "a program to a binary", higher: false, word: "faster", entries: [t("Tov", 42), t("C", 49), t("Rust", 98)] },
  { name: "binary size", what: "a program, stripped", higher: false, word: "smaller", entries: [e("Tov", 33.5, "33 KB"), e("C", 32.8, "33 KB"), e("Rust", 350.7, "351 KB")] },
]

function ratioOf(r: Row, x: Entry): f64 {
  const tov = r.entries[0]!.value
  return r.higher ? tov / x.value : x.value / tov
}

// the headline of a row: its lead over Rust, else over the best of the rest
type Lead = { ratio: f64, rival: string }

function leadOf(r: Row): Lead {
  let rival = r.entries[1]!
  for (const x of r.entries) {
    if (x.who === "Rust") rival = x
  }
  if (rival.who !== "Rust") {
    for (const x of r.entries) {
      if (x.who !== "Tov" && ratioOf(r, x) < ratioOf(r, rival)) rival = x
    }
  }
  return { ratio: ratioOf(r, rival), rival: rival.who }
}

function leadText(r: Row): string {
  const l = leadOf(r)
  return `${l.ratio.toFixed(1)}× ${r.word} than ${l.rival}`
}

// One benchmark's chart: a bar per runtime, labelled, Tov's first and in amber.
function renderChart(id: string, r: Row): string {
  let max = 0.0
  for (const x of r.entries) {
    max = Math.max(max, x.value)
  }
  const bars = r.entries.map(x => {
    const us = x.who === "Tov" ? " us" : ""
    return `<li class="hbar${us}"><span class="hb-who">${x.who}</span><span class="hb-track"><span class="hb-fill" style="--w:${(x.value / max * 100).toFixed(1)}%"></span></span><span class="hb-val">${x.label}</span></li>`
  })
  const read = r.higher ? "Longer is better." : "Shorter is better."
  return `<div class="cp cp-${id}"><p class="cp-head"><b>${leadText(r)}</b><span>${r.name}: ${r.what}</span></p><ul class="hbars">${bars.join("")}</ul><p class="cp-note">${read}</p></div>`
}

// The benchmarks: pick one from the list, see its chart (no script: radio inputs and :checked).
function renderBench(): string {
  let rows: Row[] = []
  for (const r of programRows) {
    rows.push(r)
  }
  for (const r of systemRows) {
    rows.push(r)
  }
  const ids = rows.map((r, i) => `b${i}`)
  const inputs = rows.map((r, i) => `<input type="radio" name="bench" id="pick-${ids[i]!}" class="bench-pick"${i === 0 ? " checked" : ""}>`).join("")
  const item = (r: Row, i: int) => `<li><label for="pick-${ids[i]!}"><code>${r.name}</code><span>${leadText(r)}</span></label></li>`
  const programs = programRows.map((r, i) => item(r, i)).join("")
  const systems = systemRows.map((r, i) => item(r, programRows.length + i)).join("")
  const charts = rows.map((r, i) => renderChart(ids[i]!, r)).join("")
  const rules = ids.map(id => `#pick-${id}:checked ~ .bx .cp-${id} { display: block; } #pick-${id}:checked ~ .bx label[for="pick-${id}"] { background: rgba(228,169,90,.14); border-color: var(--crust); color: #fff; } #pick-${id}:focus-visible ~ .bx label[for="pick-${id}"] { outline: 3px solid var(--crust); outline-offset: 2px; }`).join("\n")
  return `<style>${rules}</style><div class="explorer">${inputs}<div class="bx"><nav class="bx-list" aria-label="Benchmarks"><p>Programs</p><ul>${programs}</ul><p>Servers and builds</p><ul>${systems}</ul></nav><div class="bx-charts">${charts}</div></div></div>`
}

// ---------------------------------------------------------------- Cap

// capcodec, Cap's H.264 screen encoder written in Tov, against x264 at its veryfast preset at the
// same quality (VMAF): how many times faster, wall time on one thread, live preset (Cap's
// apps/media-server/capcodec-benchmarks.md, main 00fecf7)
type Clip = { name: string, speedup: f64 }

const clips: Clip[] = [
  { name: "Idle screen", speedup: 8.11 },
  { name: "Code, 4K", speedup: 7.96 },
  { name: "Busy UI, 60 fps", speedup: 7.23 },
  { name: "Slow typing", speedup: 6.88 },
  { name: "Busy UI", speedup: 6.55 },
  { name: "Dark mode", speedup: 6.54 },
  { name: "Code editor", speedup: 6.52 },
  { name: "Slides", speedup: 4.64 },
  { name: "Scrolling text", speedup: 4.40 },
  { name: "Webcam overlay", speedup: 4.21 },
  { name: "Dashboard", speedup: 3.51 },
  { name: "Full-motion video", speedup: 1.54 },
]

function renderClips(): string {
  const rows = clips.map((c, i) => `<li style="--w:${(c.speedup / 9.0 * 100).toFixed(1)}%;--i:${i}"><span class="cl-name">${c.name}</span><span class="cl-track"><span class="cl-fill"></span></span><span class="cl-val">${c.speedup.toFixed(1)}×</span></li>`).join("")
  return `<ul class="clips" aria-label="How many times faster than x264, by recording">${rows}</ul>`
}

const capLogo = `<svg class="cap-logo" viewBox="0 0 1631 1631" width="44" height="44" aria-label="Cap" role="img"><rect x="20" y="20" width="1590" height="1590" rx="306" fill="#fff" stroke="#E7EAF0" stroke-width="41"/><circle cx="815.5" cy="815.5" r="652.4" fill="#4785FF"/><circle cx="815.5" cy="815.5" r="530.1" fill="#ADC9FF"/><circle cx="815.5" cy="815.5" r="407.7" fill="#fff"/></svg>`

// ---------------------------------------------------------------- the agent

// the prompt a person gives their agent (copied whole, shown whole)
export const agentPrompt = [
  "Use Tov (https://tov.sh) for this: a programming language with TypeScript's syntax that compiles to native binaries faster than Rust's.",
  "",
  "1. Install it: curl -fsSL https://tov.sh/install.sh | sh",
  "2. Read https://tov.sh/llms.txt. Tov is TypeScript without a few things (no any, null or ==; int and f64 are separate types; a call that can fail is marked try).",
  "3. Write .tov files. After every edit, run `tov check --json <files>` and apply each fix marked \"safe\".",
  "4. Run with `tov run main.tov`; ship with `tov build main.tov -o app`, one binary.",
].join("\n")

const installLine = "curl -fsSL https://tov.sh/install.sh | sh"

function esc(s: string): string {
  return s.split("&").join("&amp;").split("<").join("&lt;").split(">").join("&gt;").split("\"").join("&quot;")
}

const copyIcon = `<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 3.5v-.5a1.5 1.5 0 0 0-1.5-1.5H4a1.5 1.5 0 0 0-1.5 1.5v5A1.5 1.5 0 0 0 4 9.5h.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`

function copyButton(target: string, label: string, done: string, cls: string): string {
  return `<button type="button" class="copy ${cls}" data-copy="${target}" data-done="${done}">${copyIcon}<span class="label">${label}</span></button>`
}

// the agent loop: a server as an agent first writes it, the compiler's answer, and the build
// (real output: tov check --json, trimmed, and tov build)
const written = [
  `<span class="d">// hello.tov</span>`,
  `Bun.serve({`,
  `  port: 3000,`,
  `  fetch(req) {`,
  `    <span class="k">const</span> url = <mark>new URL(req.url)</mark>`,
  `    <span class="k">return new</span> Response(<span class="s">\`Hello from \${url.pathname}\`</span>)`,
  `  },`,
  `})`,
].join("\n")

const checked = [
  `<span class="d">$</span> tov check --json`,
  `{`,
  `  <span class="a">"code"</span>: <span class="e">"T0831"</span>,`,
  `  <span class="a">"message"</span>: "\`new URL\` can throw \`TypeError\`; mark the call \`try\` to pass the error on, or catch it",`,
  `  <span class="a">"fixes"</span>: [{`,
  `    <span class="a">"applicability"</span>: <span class="f">"safe"</span>,`,
  `    <span class="a">"edits"</span>: [{ "line": 4, "col": 17, "text": <span class="f">"try "</span> }]`,
  `  }]`,
  `}`,
].join("\n")

const shipped = [
  `<span class="d">// the agent applies the fix</span>`,
  `<span class="k">const</span> url = <ins>try</ins> new URL(req.url)`,
  ``,
  `<span class="d">$</span> tov build hello.tov`,
  `build: hello`,
  `<span class="d">$</span> ls -lh hello`,
  `<span class="a">152K</span> hello`,
  `<span class="d">$</span> ./hello & curl :3000/agents`,
  `Hello from /agents`,
].join("\n")

const npmExample = [
  `<span class="d">// main.tov: the whole port</span>`,
  `<span class="k">import</span> server <span class="k">from</span> <span class="s">"cap-media-server"</span>`,
  `<span class="k">import</span> { serve } <span class="k">from</span> <span class="s">"bun"</span>`,
  ``,
  `<span class="k">function</span> main() {`,
  `  <span class="k">try</span> serve(server)`,
  `}`,
].join("\n")

// small: copying, and the race's balls held still for reduced motion (CSS does the rest)
const script = `
for (const b of document.querySelectorAll("[data-copy]")) {
  b.addEventListener("click", async () => {
    const text = document.getElementById(b.dataset.copy).textContent;
    try { await navigator.clipboard.writeText(text); }
    catch (e) {
      const t = document.createElement("textarea");
      t.value = text; document.body.appendChild(t); t.select(); document.execCommand("copy"); t.remove();
    }
    const label = b.querySelector(".label"), was = label.textContent;
    label.textContent = b.dataset.done; b.classList.add("done");
    setTimeout(() => { label.textContent = was; b.classList.remove("done"); }, 1800);
  });
}`

