// The landing page's stylesheet, inlined into the page so it renders from one response.

export const css = `
@font-face {
  font-family: "Schibsted Grotesk";
  src: url(/fonts/schibsted-grotesk.woff2) format("woff2");
  font-weight: 400 900;
  font-display: swap;
}
:root {
  --paper: #F5F6F9;
  --panel: #FFFFFF;
  --ink: #18204A;
  --ink-2: #545C80;
  --ink-3: #8A90AC;
  --rule: #DCE0EA;
  --crust: #E4A95A;
  --crust-ink: #9A5B12;
  --track: #E9ECF3;
  --red: #C23B2E;
  --green: #2E7D57;
  --term: #141A3C;
  --term-2: #1B2250;
  --term-ink: #E4E7F5;
  --term-dim: #8A92BD;
  --term-red: #FF8F80;
  --term-green: #8BD9AE;
  --term-amber: #F2C37E;
  --sans: "Schibsted Grotesk", ui-sans-serif, system-ui, sans-serif;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --paper: #0E1226;
    --panel: #151A33;
    --ink: #E8EAF6;
    --ink-2: #A8AECB;
    --ink-3: #6D7497;
    --rule: #262D50;
    --crust-ink: #F2C37E;
    --track: #1D2342;
    --red: #FF8F80;
    --green: #8BD9AE;
    --term: #090C1C;
    --term-2: #121734;
  }
}
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 1.125rem;
  line-height: 1.6;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration-color: var(--crust); text-decoration-thickness: 2px; text-underline-offset: 3px; }
a:hover { text-decoration-color: currentColor; }
:focus-visible { outline: 3px solid var(--crust); outline-offset: 3px; border-radius: 6px; }
code, pre { font-family: var(--mono); font-size: .875em; }
p code, li code, dd code { background: var(--track); padding: .1em .35em; border-radius: 5px; white-space: nowrap; }

.wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

/* ---- header */
header.top { display: flex; align-items: center; justify-content: space-between; padding: 22px 0; }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; font-size: 1.5rem; letter-spacing: -.035em; }
.brand img { width: 50px; height: auto; transition: transform .5s cubic-bezier(.3, 1.6, .5, 1); }
.brand:hover img { transform: translateX(4px) rotate(8deg); }
nav ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; font-size: 1rem; font-weight: 500; }
nav a { text-decoration: none; color: var(--ink-2); }
nav a:hover { color: var(--ink); }

/* ---- hero */
.hero { padding: 64px 0 24px; }
h1 {
  font-size: clamp(2.6rem, 7vw, 5.6rem);
  line-height: .98;
  letter-spacing: -.048em;
  font-weight: 800;
  margin: 0 0 28px;
}
h1 span { display: block; }
h1 span + span { color: var(--ink-2); }
.lede { font-size: clamp(1.125rem, 1.8vw, 1.375rem); line-height: 1.5; color: var(--ink-2); max-width: 40rem; margin: 0 0 32px; }
.lede strong { color: var(--ink); font-weight: 600; }
.actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
.note { font-size: .9375rem; color: var(--ink-3); margin: 18px 0 0; }

@media (prefers-reduced-motion: no-preference) {
  h1 span, .lede, .actions, .note, .race {
    animation: rise .9s cubic-bezier(.2, .8, .2, 1) both;
  }
  h1 span + span { animation-delay: .08s; }
  .lede { animation-delay: .16s; }
  .actions { animation-delay: .24s; }
  .note { animation-delay: .3s; }
  .race { animation-delay: .36s; }
}
@keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

/* ---- copy buttons */
.copy {
  display: inline-flex; align-items: center; gap: 9px; cursor: pointer;
  font: inherit; font-weight: 600; font-size: 1rem; line-height: 1.2;
  border: 1.5px solid var(--ink); border-radius: 12px; padding: 13px 20px;
  background: transparent; color: var(--ink);
  transition: transform .15s ease, background .2s ease, border-color .2s ease;
}
.copy svg { width: 17px; height: 17px; flex: none; }
.copy:active { transform: scale(.97); }
.copy.primary { background: var(--ink); color: var(--paper); }
.copy.primary:hover { background: var(--ink-2); border-color: var(--ink-2); }
.copy.small { padding: 7px 11px; font-size: .875rem; border-radius: 9px; border-color: var(--rule); color: var(--ink-2); }
.copy.small:hover { color: var(--ink); border-color: var(--ink-3); }
.copy.done { background: var(--green); border-color: var(--green); color: #fff; }
.install { display: flex; align-items: center; gap: 10px; background: var(--panel); border: 1px solid var(--rule); border-radius: 12px; padding: 6px 6px 6px 16px; max-width: 100%; }
.install code { font-size: .9rem; white-space: nowrap; overflow-x: auto; color: var(--ink); }
.install .d { color: var(--ink-3); }

/* ---- the race */
.race {
  margin: 52px 0 0; background: var(--term); color: var(--term-ink); border-radius: 22px;
  padding: 22px 26px 26px; position: relative; overflow: hidden;
}
.race::before {
  content: ""; position: absolute; inset: -40% -10% auto auto; width: 60%; height: 120%;
  background: radial-gradient(closest-side, rgba(228, 169, 90, .16), transparent);
  pointer-events: none;
}
.race-pick { position: absolute; opacity: 0; pointer-events: none; }
.tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 18px; position: relative; }
.tabs label {
  cursor: pointer; font-size: .9375rem; font-weight: 600; color: var(--term-dim);
  padding: 7px 14px; border-radius: 999px; transition: color .2s ease, background .2s ease;
}
.tabs label:hover { color: var(--term-ink); }
.board { display: none; position: relative; }
.race-title { margin: 0 0 14px; color: var(--term-dim); font-size: .9375rem; }
.lanes { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.lane { display: grid; grid-template-columns: 8.5rem 1fr 9.5rem; gap: 16px; align-items: center; }
.lane .who { font-weight: 600; font-size: 1rem; color: var(--term-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lane.us .who { color: var(--term-ink); }
.lane .track {
  position: relative; height: 26px; border-radius: 999px; background: var(--term-2);
  container-type: inline-size;
}
.lane .ball {
  position: absolute; left: 4px; top: 4px; width: 18px; height: 18px; border-radius: 50%;
  background: #4A5288;
  animation: bounce var(--t) linear infinite alternate;
  will-change: transform;
}
.lane.us .ball { background: var(--crust); box-shadow: 0 0 0 5px rgba(228, 169, 90, .16), 0 0 22px rgba(228, 169, 90, .55); }
/* (Tov's ball is the mascot: two eyes and a smile) */
.lane.us .ball::before { content: ""; position: absolute; left: 5px; top: 6px; width: 2.6px; height: 2.6px; border-radius: 50%; background: #1E2A66; box-shadow: 5.4px 0 0 #1E2A66; }
.lane.us .ball::after { content: ""; position: absolute; left: 6.6px; top: 9.6px; width: 4.6px; height: 2.4px; border: 1.3px solid #1E2A66; border-top: 0; border-radius: 0 0 4px 4px; }
@keyframes bounce {
  0% { transform: translateX(0) scale(.7, 1.22); }
  7% { transform: translateX(calc((100cqw - 26px) * .07)) scale(1); }
  93% { transform: translateX(calc((100cqw - 26px) * .93)) scale(1); }
  100% { transform: translateX(calc(100cqw - 26px)) scale(.7, 1.22); }
}
.lane .val { display: flex; flex-direction: column; line-height: 1.25; text-align: right; }
.lane .val b { font-variant-numeric: tabular-nums; font-size: 1rem; color: var(--term-ink); }
.lane .val i { font-style: normal; font-size: .8125rem; color: var(--term-dim); }
.lane.us .val i { color: var(--term-amber); }
.race-caption { color: var(--ink-3); font-size: .9375rem; margin: 14px 0 0; max-width: 46rem; }
@media (prefers-reduced-motion: reduce) {
  .lane .ball { animation: none; }
}
${raceSelectors()}

/* ---- sections */
section { padding: 104px 0 0; }
h2 { font-size: clamp(2rem, 4vw, 2.875rem); line-height: 1.05; letter-spacing: -.035em; font-weight: 800; margin: 0 0 18px; max-width: 22ch; text-wrap: balance; }
.intro { color: var(--ink-2); margin: 0 0 36px; max-width: 40rem; }

.loop {
  background: var(--term); color: var(--term-ink); border-radius: 18px;
  display: grid; grid-template-columns: 1.05fr 1.15fr .9fr; overflow: hidden;
}
.step { padding: 22px 24px 26px; min-width: 0; }
.step + .step { border-left: 1px solid rgba(255,255,255,.08); }
.step h3 { margin: 0 0 14px; font-size: .9375rem; font-weight: 600; color: var(--term-ink); display: flex; gap: 10px; align-items: baseline; }
.step h3 span { color: var(--term-amber); font-variant-numeric: tabular-nums; }
.step pre { margin: 0; white-space: pre-wrap; word-break: break-word; line-height: 1.6; font-size: .8125rem; color: var(--term-ink); }
.loop .d { color: var(--term-dim); }
.loop .k { color: #A9B8FF; }
.loop .s { color: var(--term-green); }
.loop .e { color: var(--term-red); }
.loop .f { color: var(--term-green); }
.loop .a { color: var(--term-amber); }
.loop mark { background: rgba(255, 143, 128, .16); color: inherit; border-bottom: 2px wavy var(--term-red); }
.loop ins { text-decoration: none; background: rgba(139, 217, 174, .18); color: var(--term-green); border-radius: 3px; padding: 0 2px; }

.reasons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 56px; margin: 48px 0 0; }
.reasons h3 { font-size: 1.25rem; letter-spacing: -.015em; margin: 0 0 8px; font-weight: 700; }
.reasons p { margin: 0; color: var(--ink-2); }

/* ---- numbers */
.stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0 0 56px; border-top: 1px solid var(--rule); }
.stats div { padding: 22px 22px 4px 0; }
.stats div + div { padding-left: 22px; border-left: 1px solid var(--rule); }
.stats dt { font-size: clamp(2.4rem, 4.6vw, 3.6rem); font-weight: 800; letter-spacing: -.05em; line-height: 1; margin: 0 0 12px; }
.stats dd { margin: 0; color: var(--ink-2); font-size: 1rem; line-height: 1.45; }
.chart .how { font-size: .9375rem; color: var(--ink-3); margin: 0 0 22px; }
.groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px 44px; }
.group h4 { font-family: var(--mono); font-size: .875rem; font-weight: 600; margin: 0 0 10px; }
.bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
.bar { display: grid; grid-template-columns: 3rem 1fr 4.25rem; align-items: center; gap: 10px; font-size: .875rem; }
.bar .who { color: var(--ink-2); }
.bar .track { height: 12px; background: var(--track); border-radius: 4px; overflow: hidden; }
.bar .fill { display: block; height: 100%; width: var(--w); background: var(--ink-3); border-radius: 4px; }
.bar .val { text-align: right; font-variant-numeric: tabular-nums; color: var(--ink-2); }
.bar.us .who, .bar.us .val { color: var(--ink); font-weight: 700; }
.bar.us .fill { background: var(--crust); }
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .bar .fill { animation: grow linear both; animation-timeline: view(); animation-range: entry 10% cover 35%; }
    .stats dt { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% cover 25%; }
  }
}
@keyframes grow { from { width: 0; } to { width: var(--w); } }
.fine { font-size: .9375rem; color: var(--ink-3); margin: 34px 0 0; max-width: 48rem; }

/* ---- npm */
.npm { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: start; }
.code {
  margin: 0; background: var(--panel); border: 1px solid var(--rule); border-radius: 14px;
  padding: 20px 22px; line-height: 1.65; overflow-x: auto; font-size: .875rem;
}
.code .d { color: var(--ink-3); }
.code .k { color: #3B4FC4; }
.code .s { color: var(--green); }
@media (prefers-color-scheme: dark) { .code .k { color: #A9B8FF; } }
.facts { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 14px; }
.facts li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 16px; align-items: baseline; border-top: 1px solid var(--rule); padding-top: 14px; }
.facts b { font-size: 1.5rem; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
.facts span { color: var(--ink-2); font-size: 1rem; }

/* ---- start */
.start { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 56px; align-items: start; }
.start p { color: var(--ink-2); margin: 0 0 16px; }
.start .aside { font-size: 1rem; color: var(--ink-3); }
.prompt-card { background: var(--term); color: var(--term-ink); border-radius: 18px; padding: 22px 24px; display: grid; gap: 18px; justify-items: start; }
.prompt-card pre { margin: 0; white-space: pre-wrap; line-height: 1.6; font-size: .875rem; color: var(--term-ink); }
.prompt-card .copy.primary { background: var(--crust); border-color: var(--crust); color: #1A1407; }
.prompt-card .copy.primary:hover { background: var(--term-amber); border-color: var(--term-amber); }
.prompt-card .copy.done { background: var(--term-green); border-color: var(--term-green); color: #0D2A1C; }

/* ---- status */
.status { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px; }
.status h3 { font-size: 1.125rem; margin: 0 0 12px; }
.status ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
.status li { padding-left: 28px; position: relative; color: var(--ink-2); }
.status li::before { position: absolute; left: 0; top: 0; font-weight: 700; }
.status .yes li::before { content: "✓"; color: var(--green); }
.status .not li::before { content: "–"; color: var(--ink-3); }

footer { margin: 120px 0 0; padding: 32px 0 48px; border-top: 1px solid var(--rule); }
footer .wrap { display: flex; gap: 16px; align-items: center; }
footer img { width: 44px; height: auto; flex: none; }
footer p { margin: 0; color: var(--ink-2); font-size: .9375rem; }
footer b { color: var(--ink); font-variant-numeric: tabular-nums; font-weight: 600; }

@media (max-width: 900px) {
  .loop { grid-template-columns: 1fr; }
  .step + .step { border-left: 0; border-top: 1px solid rgba(255,255,255,.08); }
  .reasons, .npm, .status, .start { grid-template-columns: minmax(0, 1fr); gap: 36px; }
  .groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stats div:nth-child(3) { padding-left: 0; border-left: 0; }
  .stats div:nth-child(n+3) { border-top: 1px solid var(--rule); }
}
@media (max-width: 600px) {
  .wrap { padding: 0 16px; }
  nav ul { gap: 18px; }
  nav .optional { display: none; }
  .hero { padding: 40px 0 16px; }
  section { padding: 76px 0 0; }
  .race { padding: 18px 16px 20px; border-radius: 18px; }
  .lane { grid-template-columns: 5.5rem 1fr 5.5rem; gap: 10px; }
  .lane .who { font-size: .875rem; }
  .lane .val b { font-size: .875rem; }
  .groups { grid-template-columns: minmax(0, 1fr); }
  .install { width: 100%; }
  .copy.primary { width: 100%; justify-content: center; }
  .facts li { grid-template-columns: 6rem 1fr; }
  footer .wrap { align-items: flex-start; }
}
`

// (the chosen tab's board shows, and its tab lights: one rule per race, by id)
function raceSelectors(): string {
  const ids = ["http", "fetch", "trees", "compile", "memory"]
  return ids
    .map(id => `#race-${id}:checked ~ .boards .board-${id} { display: block; }
#race-${id}:checked ~ .tabs label[for="race-${id}"] { background: var(--term-ink); color: var(--term); }
#race-${id}:focus-visible ~ .tabs label[for="race-${id}"] { outline: 3px solid var(--crust); outline-offset: 2px; }`)
    .join("\n")
}
