// The landing page's stylesheet, inlined into the page so it renders from one response.

export const css = `
@font-face {
  font-family: "Schibsted Grotesk";
  src: url(/fonts/schibsted-grotesk.woff2) format("woff2");
  font-weight: 400 900;
  font-display: swap;
}
/* quiet: white and graphite, the hummingbird's amber the only colour */
:root {
  --paper: #FBFBFA;
  --panel: #FFFFFF;
  --sunk: #F4F4F2;
  --ink: #1D1D20;
  --ink-2: #5F5F67;
  --ink-3: #9B9BA3;
  --rule: #E9E9E6;
  --bar: #DCDCE0;
  --crust: #E4A95A;
  --crust-ink: #A8681A;
  --green: #2F7A55;
  --red: #B9473B;
  --blue: #3C5FC0;
  --sans: "Schibsted Grotesk", ui-sans-serif, system-ui, sans-serif;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --paper: #121214;
    --panel: #18181B;
    --sunk: #1C1C1F;
    --ink: #EDEDEF;
    --ink-2: #A3A3AB;
    --ink-3: #6E6E76;
    --rule: #27272B;
    --bar: #34343A;
    --crust-ink: #F0C27F;
    --green: #8FD3AE;
    --red: #F2958A;
    --blue: #9DB2F5;
  }
}
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 1.0625rem;
  line-height: 1.65;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration-color: var(--rule); text-decoration-thickness: 1.5px; text-underline-offset: 3px; transition: text-decoration-color .15s ease; }
a:hover { text-decoration-color: currentColor; }
:focus-visible { outline: 2px solid var(--crust); outline-offset: 3px; border-radius: 6px; }
code, pre { font-family: var(--mono); font-size: .875em; }
p code, li code, dd code { background: var(--sunk); padding: .1em .35em; border-radius: 5px; white-space: nowrap; }

.wrap { max-width: 1040px; margin: 0 auto; padding: 0 24px; }

/* ---- header */
header.top { display: flex; align-items: center; justify-content: space-between; padding: 26px 0; }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.brand .name { display: grid; font-weight: 700; font-size: 1.375rem; letter-spacing: -.035em; line-height: 1; }
.brand small { font-size: .6875rem; font-weight: 500; letter-spacing: 0; color: var(--ink-3); margin-top: 4px; }
/* the mascot (inline: its parts move on hover) */
.hb { width: 46px; height: auto; overflow: visible; color: var(--ink-3); }
.hb-bird, .hb-wing, .hb-eye { transform-box: fill-box; }
.hb-bird { transform-origin: 60% 60%; transition: transform .45s cubic-bezier(.3, 1.5, .5, 1); }
.hb-wing { transform-origin: 92% 96%; }
.hb-eye { transform-origin: center; }
.hb-blur { opacity: 0; transition: opacity .2s ease; }
.hb-lines path { stroke-dasharray: 20 0; }
@media (prefers-reduced-motion: no-preference) {
  .brand:hover .hb-bird { animation: hb-dart .5s cubic-bezier(.2, 1.4, .4, 1) both, hb-hover 1.2s ease-in-out .5s infinite; }
  .brand:hover .hb-wing { animation: hb-flap .06s ease-in-out infinite alternate; }
  .brand:hover .hb-blur { opacity: 1; }
  .brand:hover .hb-lines path { stroke-dasharray: 7 5; animation: hb-stream .3s linear infinite; }
  .brand:hover .hb-eye { animation: hb-blink 2.6s ease-in-out .9s infinite; }
}
@keyframes hb-dart {
  0% { transform: translate(0, 0) rotate(0deg); }
  45% { transform: translate(12px, -9px) rotate(-9deg); }
  100% { transform: translate(8px, -6px) rotate(-5deg); }
}
@keyframes hb-hover {
  0%, 100% { transform: translate(8px, -6px) rotate(-5deg); }
  50% { transform: translate(8px, -11px) rotate(-2deg); }
}
@keyframes hb-flap { from { transform: rotate(-12deg) scale(1, 1); } to { transform: rotate(30deg) scale(.92, .55); } }
@keyframes hb-stream { to { stroke-dashoffset: 24; } }
@keyframes hb-blink { 0%, 90%, 100% { transform: scaleY(1); } 94% { transform: scaleY(.1); } }
nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; font-size: .9375rem; }
nav a { text-decoration: none; color: var(--ink-2); }
nav a:hover { color: var(--ink); }

/* ---- hero */
.hero { padding: 88px 0 24px; }
h1 {
  font-size: clamp(2.4rem, 6vw, 4.5rem);
  line-height: 1;
  letter-spacing: -.045em;
  font-weight: 700;
  margin: 0 0 26px;
}
h1 span { display: block; }
h1 span + span { color: var(--ink-3); }
.lede { font-size: clamp(1.0625rem, 1.6vw, 1.25rem); line-height: 1.55; color: var(--ink-2); max-width: 36rem; margin: 0 0 36px; }
.lede strong { color: var(--ink); font-weight: 600; }
.actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

@media (prefers-reduced-motion: no-preference) {
  .sing, h1 span, .lede, .actions, .race {
    animation: rise 1s cubic-bezier(.2, .8, .2, 1) both;
  }
  h1 span + span { animation-delay: .08s; }
  .lede { animation-delay: .16s; }
  .actions { animation-delay: .24s; }
  .race { animation-delay: .36s; }
}
@keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

/* ---- copy buttons */
.copy {
  display: inline-flex; align-items: center; gap: 9px; cursor: pointer;
  font: inherit; font-weight: 500; font-size: .9375rem; line-height: 1.2;
  border: 1px solid var(--rule); border-radius: 10px; padding: 11px 18px;
  background: var(--panel); color: var(--ink);
  transition: transform .15s ease, background .2s ease, border-color .2s ease, color .2s ease;
}
.copy svg { width: 16px; height: 16px; flex: none; }
.copy:active { transform: scale(.97); }
.copy.primary { background: var(--ink); border-color: var(--ink); color: var(--paper); }
.copy.primary:hover { opacity: .88; }
.copy.small { padding: 6px 10px; font-size: .8125rem; border-radius: 7px; color: var(--ink-2); }
.copy.small:hover { color: var(--ink); border-color: var(--ink-3); }
.copy.done { background: var(--green); border-color: var(--green); color: var(--paper); }
.sing { display: inline-flex; align-items: center; gap: 9px; margin: 0 0 26px; padding: 6px 14px 6px 12px; border-radius: 999px; border: 1px solid var(--rule); background: var(--panel); color: var(--ink-2); font-size: .875rem; font-weight: 500; line-height: 1.2; text-decoration: none; transition: color .2s ease, border-color .2s ease; }
.sing:hover { color: var(--ink); border-color: var(--ink-3); }
.sing-go { color: var(--ink-3); transition: transform .2s ease, color .2s ease; }
.sing:hover .sing-go { transform: translateX(3px); color: var(--ink); }
.sing-eq { display: flex; align-items: flex-end; gap: 2px; height: 12px; }
.sing-eq i { width: 2.5px; height: 100%; border-radius: 1px; background: var(--crust); transform-origin: 50% 100%; transform: scaleY(.45); }
@media (prefers-reduced-motion: no-preference) {
  .sing-eq i { animation: sing-eq .9s ease-in-out infinite alternate; }
  .sing-eq i:nth-child(2) { animation-duration: .65s; animation-delay: -.3s; }
  .sing-eq i:nth-child(3) { animation-duration: 1.05s; animation-delay: -.5s; }
}
@keyframes sing-eq { from { transform: scaleY(.3); } to { transform: scaleY(1); } }
.install { display: flex; align-items: center; gap: 10px; background: var(--panel); border: 1px solid var(--rule); border-radius: 10px; padding: 5px 5px 5px 16px; max-width: 100%; }
.install code { font-size: .875rem; white-space: nowrap; overflow-x: auto; color: var(--ink); }
.install .d { color: var(--ink-3); }

/* ---- the race */
.race {
  margin: 72px 0 0; background: var(--panel); border: 1px solid var(--rule); border-radius: 18px;
  padding: 18px 24px 24px;
}
.race-pick { position: absolute; opacity: 0; pointer-events: none; }
.tabs { display: inline-flex; flex-wrap: wrap; gap: 2px; margin: 0 0 20px; padding: 3px; background: var(--sunk); border-radius: 10px; }
.tabs label {
  cursor: pointer; font-size: .875rem; font-weight: 500; color: var(--ink-2);
  padding: 5px 13px; border-radius: 8px; transition: color .2s ease, background .2s ease, box-shadow .2s ease;
}
.tabs label:hover { color: var(--ink); }
.board { display: none; }
.race-title { margin: 0 0 16px; color: var(--ink-3); font-size: .875rem; }
.lanes { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.lane { display: grid; grid-template-columns: 8rem 1fr 8.5rem; gap: 16px; align-items: center; }
.lane .who { font-size: .9375rem; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lane.us .who { color: var(--ink); font-weight: 600; }
.lane .track {
  position: relative; height: 22px; border-radius: 999px; background: var(--sunk);
  container-type: inline-size;
}
.lane .ball {
  position: absolute; left: 3px; top: 3px; width: 16px; height: 16px; border-radius: 50%;
  background: var(--bar);
  animation: bounce var(--t) linear infinite alternate;
  will-change: transform;
}
.lane.us .ball { background: var(--crust); box-shadow: 0 0 0 4px rgba(228, 169, 90, .18); }
/* (Tov's ball is the mascot: two eyes and a smile) */
.lane.us .ball::before { content: ""; position: absolute; left: 4.4px; top: 5.4px; width: 2.4px; height: 2.4px; border-radius: 50%; background: #26262B; box-shadow: 4.8px 0 0 #26262B; }
.lane.us .ball::after { content: ""; position: absolute; left: 5.8px; top: 8.6px; width: 4.2px; height: 2.2px; border: 1.2px solid #26262B; border-top: 0; border-radius: 0 0 4px 4px; }
@keyframes bounce {
  0% { transform: translateX(0) scale(.7, 1.22); }
  7% { transform: translateX(calc((100cqw - 22px) * .07)) scale(1); }
  93% { transform: translateX(calc((100cqw - 22px) * .93)) scale(1); }
  100% { transform: translateX(calc(100cqw - 22px)) scale(.7, 1.22); }
}
.lane .val { display: flex; flex-direction: column; line-height: 1.25; text-align: right; }
.lane .val b { font-variant-numeric: tabular-nums; font-size: .9375rem; font-weight: 600; }
.lane .val i { font-style: normal; font-size: .75rem; color: var(--ink-3); }
.lane.us .val i { color: var(--crust-ink); }
@media (prefers-reduced-motion: reduce) {
  .lane .ball { animation: none; }
}
${raceSelectors()}

/* ---- sections */
section { padding: 144px 0 0; }
h2 { font-size: clamp(1.75rem, 3.2vw, 2.375rem); line-height: 1.1; letter-spacing: -.035em; font-weight: 700; margin: 0 0 14px; max-width: 24ch; text-wrap: balance; }
.intro { color: var(--ink-2); margin: 0 0 40px; max-width: 36rem; }

.loop {
  background: var(--panel); border: 1px solid var(--rule); border-radius: 16px;
  display: grid; grid-template-columns: 1.05fr 1.15fr .9fr; overflow: hidden;
}
.step { padding: 20px 22px 24px; min-width: 0; }
.step + .step { border-left: 1px solid var(--rule); }
.step h3 { margin: 0 0 14px; font-size: .875rem; font-weight: 600; display: flex; gap: 10px; align-items: baseline; }
.step h3 span { color: var(--ink-3); font-variant-numeric: tabular-nums; font-weight: 500; }
.step pre { margin: 0; white-space: pre-wrap; word-break: break-word; line-height: 1.6; font-size: .8125rem; color: var(--ink); }
.loop .d { color: var(--ink-3); }
.loop .k, .code .k { color: var(--blue); }
.loop .s, .code .s { color: var(--green); }
.loop .e { color: var(--red); }
.loop .f { color: var(--green); }
.loop .a { color: var(--crust-ink); }
.loop mark { background: none; color: inherit; text-decoration: underline wavy var(--red); text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
.loop ins { text-decoration: none; background: rgba(47, 122, 85, .1); color: var(--green); border-radius: 3px; padding: 0 2px; }

#agents h2 { margin-bottom: 36px; }
.reasons { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 48px; margin: 56px 0 0; }
.reasons h3 { font-size: 1rem; margin: 0 0 6px; font-weight: 600; }
.reasons p { margin: 0; color: var(--ink-2); font-size: .9375rem; }

/* ---- the benchmarks */
/* the explorer: a list of benchmarks, and the chosen one's chart */
.explorer { margin: 0 0 24px; }
.bench-pick { position: absolute; opacity: 0; pointer-events: none; }
.bx-list { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px 18px; align-items: center; margin: 0 0 20px; }
.bx-list p { margin: 0; font-size: .8125rem; color: var(--ink-3); }
.bx-list ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
.bx-list label {
  display: inline-flex; align-items: baseline; gap: 8px; padding: 5px 12px; border-radius: 999px; cursor: pointer;
  border: 1px solid var(--rule); color: var(--ink-2); transition: background .15s ease, color .15s ease, border-color .15s ease;
}
.bx-list label:hover { color: var(--ink); border-color: var(--ink-3); }
.bx-list label code { color: inherit; background: none; padding: 0; font-size: .8125rem; }
.bx-list label span { font-size: .75rem; color: var(--crust-ink); }
.bx-charts { background: var(--panel); border: 1px solid var(--rule); border-radius: 16px; padding: 30px 32px 24px; }
.cp { display: none; }
.cp-head { margin: 0; }
.cp-head b { display: block; font-size: clamp(1.5rem, 2.8vw, 2.125rem); font-weight: 700; letter-spacing: -.035em; line-height: 1.1; }
.cp-head span { display: block; margin-top: 6px; color: var(--ink-3); font-size: .9375rem; }
.hbars { list-style: none; margin: 30px 0 0; padding: 0; display: grid; gap: 12px; }
.hbar { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) 7rem; gap: 14px; align-items: center; }
.hb-who { color: var(--ink-2); font-size: .9375rem; }
.hbar.us .hb-who { color: var(--ink); font-weight: 600; }
.hb-track { height: 26px; border-radius: 7px; background: var(--sunk); overflow: hidden; }
.hb-fill { display: block; height: 100%; width: var(--w); border-radius: 7px; background: var(--bar); }
.hbar.us .hb-fill { background: var(--crust); }
.hb-val { text-align: right; font-variant-numeric: tabular-nums; font-size: .9375rem; color: var(--ink-2); }
.hbar.us .hb-val { color: var(--ink); font-weight: 600; }
.cp-note { margin: 20px 0 0; font-size: .8125rem; color: var(--ink-3); }
@media (prefers-reduced-motion: no-preference) {
  /* (each time a chart is chosen: it's shown afresh, so its bars grow again) */
  .hb-fill { animation: grow .8s cubic-bezier(.2, .8, .2, 1) both; }
  .hbar:nth-child(2) .hb-fill { animation-delay: .05s; }
  .hbar:nth-child(3) .hb-fill { animation-delay: .1s; }
  .hbar:nth-child(4) .hb-fill { animation-delay: .15s; }
  .hbar:nth-child(5) .hb-fill { animation-delay: .2s; }
  .cp-head { animation: rise .5s cubic-bezier(.2, .8, .2, 1) both; }
}
@keyframes grow { from { width: 0; } to { width: var(--w); } }
.fine { color: var(--ink-3); font-size: .8125rem; margin: 0; max-width: 46rem; }

/* ---- Tov at Cap */
.cap-head { text-align: center; display: grid; justify-items: center; }
.cap-head .intro { margin-bottom: 48px; }
.pair { display: flex; align-items: center; gap: 12px; margin: 0 0 24px; color: var(--ink-3); font-size: 1rem; }
.pair svg, .pair img { display: block; }
.pair svg { width: 36px; height: 36px; }
.pair img { width: 45px; height: auto; }
.cap-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 16px; align-items: stretch; }
.cap-card {
  background: var(--panel); border: 1px solid var(--rule); border-radius: 16px; padding: 30px 30px 26px;
  display: flex; flex-direction: column; min-width: 0;
}
.cap-card h3 { margin: 0 0 16px; font-size: 1rem; font-weight: 600; }
.cap-card > p:not([class]) { color: var(--ink-2); margin: 0 0 22px; font-size: .9375rem; }
.cap-big { margin: 0 0 28px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
.cap-big b { font-size: clamp(3rem, 6vw, 4.25rem); font-weight: 700; letter-spacing: -.055em; line-height: .9; }
.cap-big span { color: var(--ink-2); font-size: 1rem; max-width: 15rem; line-height: 1.35; }
.clips { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
.clips li { display: grid; grid-template-columns: 8.4rem minmax(0, 1fr) 2.6rem; gap: 12px; align-items: center; font-size: .8125rem; }
.cl-name { color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cl-track { height: 8px; border-radius: 4px; background: var(--sunk); position: relative; }
.cl-track::before { content: ""; position: absolute; left: calc(100% / 9); top: -3px; bottom: -3px; width: 1px; background: var(--ink-3); }
.cl-fill { display: block; height: 100%; width: var(--w); border-radius: 4px; background: #7FA5FF; }
.cl-val { text-align: right; font-variant-numeric: tabular-nums; color: var(--ink); }
.clips::after { content: "1× is x264"; display: block; font-size: .75rem; color: var(--ink-3); padding-left: calc(8.4rem + 12px); }
.cap-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 26px 0 0; padding: 22px 0 0; border-top: 1px solid var(--rule); }
.cap-stats dt { font-size: 1.5rem; font-weight: 700; letter-spacing: -.03em; line-height: 1.1; }
.cap-stats dd { margin: 4px 0 0; color: var(--ink-2); font-size: .875rem; }
.cap-fine { margin: auto 0 0; padding-top: 22px; font-size: .75rem; color: var(--ink-3); }
.cap-card .code { margin: 0; }
.cap-card .facts { margin-top: 26px; }
@media (prefers-reduced-motion: no-preference) {
  .cl-fill { animation: grow 1s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * 40ms); }
  @supports (animation-timeline: view()) {
    .cl-fill { animation-timeline: view(); animation-range: entry 10% cover 40%; animation-delay: 0s; }
  }
}
.code {
  margin: 0; background: var(--sunk); border-radius: 10px;
  padding: 16px 18px; line-height: 1.65; overflow-x: auto; font-size: .8125rem;
}
.code .d { color: var(--ink-3); }
.facts { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; }
.facts li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 14px; align-items: baseline; border-top: 1px solid var(--rule); padding-top: 12px; }
.facts b { font-size: 1.25rem; font-weight: 700; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
.facts span { color: var(--ink-2); font-size: .9375rem; }

/* ---- start */
.start { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 56px; align-items: start; }
.start p { color: var(--ink-2); margin: 0 0 16px; }
.prompt-card { background: var(--panel); border: 1px solid var(--rule); border-radius: 16px; padding: 22px 24px; display: grid; gap: 18px; justify-items: start; }
.prompt-card pre { margin: 0; white-space: pre-wrap; line-height: 1.65; font-size: .8125rem; color: var(--ink-2); }

/* ---- status */
.status { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px; }
.status h3 { font-size: 1rem; font-weight: 600; margin: 0 0 12px; }
.status ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
.status li { padding-left: 26px; position: relative; color: var(--ink-2); font-size: .9375rem; }
.status li::before { position: absolute; left: 0; top: 0; }
.status .yes li::before { content: "✓"; color: var(--green); }
.status .not li::before { content: "–"; color: var(--ink-3); }

footer { margin: 144px 0 0; padding: 28px 0 44px; border-top: 1px solid var(--rule); }
footer .wrap { display: flex; gap: 14px; align-items: center; }
footer img { width: 36px; height: auto; flex: none; }
footer p { margin: 0; color: var(--ink-3); font-size: .875rem; }
footer b { color: var(--ink-2); font-variant-numeric: tabular-nums; font-weight: 600; }

@media (max-width: 900px) {
  .loop { grid-template-columns: 1fr; }
  .step + .step { border-left: 0; border-top: 1px solid var(--rule); }
  .reasons, .cap-grid, .status, .start { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .cap-grid { gap: 16px; }
  .bx-list { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  .bx-list ul { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; }
  .bx-list ul + p { margin-top: 8px; }
  .bx-list label { white-space: nowrap; }
}
@media (max-width: 600px) {
  .wrap { padding: 0 16px; }
  nav ul { gap: 18px; }
  nav .optional { display: none; }
  .hero { padding: 48px 0 16px; }
  section { padding: 96px 0 0; }
  .race { padding: 14px 14px 18px; margin-top: 48px; }
  .lane { grid-template-columns: 5.2rem 1fr 5rem; gap: 10px; }
  .lane .who { font-size: .8125rem; }
  .lane .val b { font-size: .8125rem; }
  .bx-charts { padding: 22px 18px 18px; }
  .hbar { grid-template-columns: 3.4rem minmax(0, 1fr) 5.4rem; gap: 10px; }
  .hb-track { height: 20px; }
  .hb-val { font-size: .8125rem; }
  .install { width: 100%; }
  .copy.primary { width: 100%; justify-content: center; }
  .cap-card { padding: 24px 18px 20px; }
  .clips li { grid-template-columns: 7.2rem minmax(0, 1fr) 2.4rem; gap: 8px; }
  .clips::after { padding-left: calc(7.2rem + 8px); }
  footer .wrap { align-items: flex-start; }
}
`

// (the chosen tab's board shows, and its tab lights: one rule per race, by id)
function raceSelectors(): string {
  const ids = ["http", "fetch", "trees", "compile", "memory"]
  return ids
    .map(id => `#race-${id}:checked ~ .boards .board-${id} { display: block; }
#race-${id}:checked ~ .tabs label[for="race-${id}"] { background: var(--panel); color: var(--ink); box-shadow: 0 1px 2px rgba(0, 0, 0, .08); }
#race-${id}:focus-visible ~ .tabs label[for="race-${id}"] { outline: 2px solid var(--crust); outline-offset: 2px; }`)
    .join("\n")
}
